{
  "name": "@rybosome/tspice-backend-node",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/build/Release/tspice_backend_node.node",
    "NOTICE"
  ],
  "scripts": {
    "build:native": "pnpm -w fetch:cspice && node-gyp rebuild --directory native",
    "build": "tsc -p tsconfig.json",
    "build:js": "pnpm run build",
    "build:full": "pnpm -w fetch:cspice && node-gyp rebuild --directory native && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "pnpm run --if-present pretest && vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@rybosome/tspice-backend-contract": "workspace:*",
    "@rybosome/tspice-core": "workspace:*",
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@rybosome/tspice-backend-wasm": "workspace:*",
    "node-gyp": "^11.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
