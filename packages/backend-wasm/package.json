{
  "name": "@rybosome/tspice-backend-wasm",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.web.js",
      "import": "./dist/index.node.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.web.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run stage:assets",
    "stage:assets": "node ../../scripts/copy-backend-wasm-assets.mjs",
    "pretest": "pnpm run stage:assets",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test:coverage": "node ../../scripts/run-vitest-coverage.mjs"
  },
  "dependencies": {
    "@rybosome/tspice-backend-contract": "workspace:*",
    "@rybosome/tspice-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
