{
  "name": "@rybosome/tspice-py-parity-checking",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "fixtures",
    "sidecars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo && tsc -p tsconfig.test.json --noEmit --tsBuildInfoFile .cache/typecheck-test.tsbuildinfo",
    "setup:sidecar": "uv run --locked --project sidecars/spiceypy python -c \"import spiceypy\"",
    "pretest": "node ../../scripts/prepare-package.mjs && pnpm run setup:sidecar",
    "test": "vitest run"
  },
  "dependencies": {
    "@rybosome/tspice": "workspace:*",
    "@rybosome/tspice-backend-contract": "workspace:*",
    "@rybosome/tspice-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
