{
  "name": "@rybosome/tspice-py-parity-checking",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "fixtures",
    "sidecars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm -w turbo run build --filter=@rybosome/tspice",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json --noEmit",
    "pretest": "pnpm -w turbo run build --filter=@rybosome/tspice",
    "test": "vitest run",
    "generate:cases": "node ./scripts/generate-canonical-cases.mjs"
  },
  "dependencies": {
    "@rybosome/tspice": "workspace:*",
    "@rybosome/tspice-backend-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
