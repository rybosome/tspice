[
  {
    "caseId": "ephemeris-spkobj-generated-file-success",
    "description": "spkobj returns object IDs present in a generated SPK",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkobj-happy.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H1",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKOBJ_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
        "epoch1": 0,
        "step": 120
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkobj",
        "spk": "kernels/ephemeris-spkobj-happy.bsp",
        "idsCellId": "IDS1",
        "maxCardinality": 8
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
