  {
    "caseId": "ephemeris-getelm-civil-survey",
    "description": "Observe UTC leap-year fractional day, both signed drag derivatives, implied exponents, angular units, mean motion and repeated epoch.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "ephemeris.getelm",
        "firstYear": 1957,
        "lines": [
          "1 99001U 00001A   24060.25000000 -.00001234  23456-6 -12500-4 0 12342",
          "2 99001  47.5000 211.2500 0234500 123.4000  33.5000 14.37500000123458"
        ]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
