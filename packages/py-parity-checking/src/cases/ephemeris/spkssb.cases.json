[
  {
    "caseId": "ephemeris-spkssb-generated-segment-success",
    "description": "spkssb returns a state vector relative to the solar-system barycenter",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkssb-happy.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H1",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKSSB_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
        "epoch1": 0,
        "step": 120
      },
      { "op": "ephemeris.spkcls", "handleId": "H1" },
      { "op": "kernels.furnsh", "file": "kernels/ephemeris-spkssb-happy.bsp" },
      { "op": "ephemeris.spkssb", "target": 1000, "et": 60, "ref": "J2000" }
    ],
    "expectation": { "kind": "success" }
  },
  {
    "caseId": "ephemeris-spkssb-invalid-frame-error",
    "description": "spkssb rejects an unknown reference frame",
    "workflow": [{ "op": "ephemeris.spkssb", "target": 1000, "et": 60, "ref": "NOT_A_FRAME" }],
    "expectation": { "kind": "error" }
  }
]
