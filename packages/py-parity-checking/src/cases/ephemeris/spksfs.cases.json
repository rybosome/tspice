  {
    "caseId": "ephemeris-spksfs-audit-priority-unload-reload",
    "description": "Observe selected segment changes after load/unload, cache reuse and reverse load order",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris.bsp"
        }
      },
      {
        "op": "ephemeris.spksfs",
        "et": 125.25,
        "body": 100001
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-priority.bsp"
        }
      },
      {
        "op": "ephemeris.spksfs",
        "et": 125.25,
        "body": 100001
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-ephemeris-priority.bsp"
      },
      {
        "op": "ephemeris.spksfs",
        "et": 125.25,
        "body": 100001
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-priority.bsp"
        }
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris.bsp"
        }
      },
      {
        "op": "ephemeris.spksfs",
        "et": 125.25,
        "body": 100001
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
