        "id": "output"
      },
      {
        "op": "ephemeris.spksfs",
        "body": -100011,
        "et": -5,
        "descrId": "left"
      },
      {
        "op": "ephemeris.spkpvn",
        "source": "output",
        "descriptor": "left",
        "et": -5,
        "mode": "direct"
      },
      {
        "op": "ephemeris.spksfs",
        "body": -100011,
