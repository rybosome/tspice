[
  {
    "caseId": "ephemeris-spksub-narrow-interval",
    "description": "Close/reopen a real reduced interval, unpack every output descriptor field and evaluate both endpoints.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-ephemeris.bsp"
      },
      {
        "op": "ephemeris.spklef",
        "file": "kernels/audit-ephemeris.bsp",
        "id": "load"
      },
      {
        "op": "ephemeris.spksfs",
        "body": -100011,
        "et": 0,
        "descrId": "sel"
      },
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/e03-subset.bsp",
        "ifname": "TSPICE SUBSET",
        "ncomch": 0,
        "handleId": "out"
      },
      {
        "op": "ephemeris.spksub",
        "source": "load",
        "descriptor": "sel",
        "ident": "AUTHORED SUBSET",
        "begin": -5,
        "end": 10,
        "writer": "out",
        "mode": "direct"
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "out"
      },
      {
        "op": "ephemeris.spklef",
        "file": "kernels/e03-subset.bsp",
        "id": "out-read"
      },
      {
        "op": "ephemeris.spksfs",
        "body": -100011,
        "et": 10,
        "descrId": "copied"
      },
      {
        "op": "ephemeris.spkuds",
        "descrId": "copied"
      },
      {
        "op": "ephemeris.spkpvn",
        "source": "out-read",
        "descriptor": "copied",
        "et": 10,
        "mode": "direct"
      },
      {
        "op": "ephemeris.spkuef",
        "id": "out-read"
      },
      {
        "op": "ephemeris.spkuef",
        "id": "load"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
