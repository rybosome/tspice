      },
      {
        "op": "ephemeris.spkcov",
        "spk": "kernels/audit-ephemeris.bsp",
        "idcode": 100001,
        "coverWindowId": "COV",
        "maxIntervals": 16
      },
      {
        "op": "ephemeris.spkcov",
        "spk": "kernels/audit-ephemeris-priority.bsp",
        "idcode": 100001,
        "coverWindowId": "COV",
        "maxIntervals": 16
      },
      {
        "op": "ephemeris.spkcov",
        "spk": "kernels/audit-ephemeris.bsp",
        "idcode": 100001,
        "coverWindowId": "COV",
        "maxIntervals": 16
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
