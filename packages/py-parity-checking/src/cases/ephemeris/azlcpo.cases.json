[
  {
    "caseId": "ephemeris-azlcpo-direction-and-rates",
    "description": "All four azimuth/elevation sign conventions change coordinates and signed derivatives in the actual local ellipsoid frame.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-geometry.bsp"
        }
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-geometry.tf"
        }
      },
      {
        "op": "ephemeris.azlcpo",
        "method": "ELLIPSOID",
        "target": "100102",
        "et": 21.5,
        "abcorr": "CN+S",
        "azccw": true,
        "elplsz": true,
        "obspos": [3.2, 1.7, -0.75],
        "obsctr": "100101",
        "obsref": "AUDIT_GEOMETRY_FIXED"
      },
      {
        "op": "ephemeris.azlcpo",
        "method": "ELLIPSOID",
        "target": "100102",
        "et": 21.5,
        "abcorr": "CN+S",
        "azccw": true,
        "elplsz": false,
        "obspos": [3.2, 1.7, -0.75],
        "obsctr": "100101",
        "obsref": "AUDIT_GEOMETRY_FIXED"
      },
      {
        "op": "ephemeris.azlcpo",
        "method": "ELLIPSOID",
        "target": "100102",
        "et": 21.5,
        "abcorr": "CN+S",
        "azccw": false,
        "elplsz": true,
        "obspos": [3.2, 1.7, -0.75],
        "obsctr": "100101",
        "obsref": "AUDIT_GEOMETRY_FIXED"
      },
      {
        "op": "ephemeris.azlcpo",
        "method": "ELLIPSOID",
        "target": "100102",
        "et": 21.5,
        "abcorr": "CN+S",
        "azccw": false,
        "elplsz": false,
        "obspos": [3.2, 1.7, -0.75],
        "obsctr": "100101",
        "obsref": "AUDIT_GEOMETRY_FIXED"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
