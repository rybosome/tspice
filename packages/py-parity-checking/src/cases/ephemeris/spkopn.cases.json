      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkopn-error.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H_CREATE"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H_CREATE",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKOPN_ERR_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
        "epoch1": 0,
        "step": 120
      },
      { "op": "ephemeris.spkcls", "handleId": "H_CREATE" },
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkopn-error.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H_ERR"
      }
    ],
    "expectation": { "kind": "error" }
