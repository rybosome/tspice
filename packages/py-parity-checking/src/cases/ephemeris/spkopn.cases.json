[
  {
    "caseId": "ephemeris-spkopn-create-file-success",
    "description": "spkopn creates a writable SPK and registers its logical handle",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkopn-happy.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H1",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKOPN_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
        "epoch1": 0,
        "step": 120
      },
      { "op": "ephemeris.spkcls", "handleId": "H1" },
      {
        "op": "ephemeris.spkobj",
        "spk": "kernels/ephemeris-spkopn-happy.bsp",
        "idsCellId": "IDS1",
        "maxCardinality": 8
      }
    ],
    "expectation": { "kind": "success" }
  },
  {
    "caseId": "ephemeris-spkopn-existing-file-error",
    "description": "spkopn fails when attempting to create an SPK that already exists",
