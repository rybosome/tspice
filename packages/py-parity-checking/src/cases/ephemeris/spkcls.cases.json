        "states": [
          9895.0, -19915.0, 29945.0, 0.85, -0.95, 0.6, 10000.0, -20000.0,
          30000.0, 1.25, -0.75, 0.5, 10145.0, -20065.0, 30045.0, 1.65, -0.55,
          0.4, 10330.0, -20110.0, 30080.0, 2.05, -0.35, 0.3
        ],
        "epoch1": -100.0,
        "step": 100.0
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "H"
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "scratch",
          "rel": "audit-written.bsp"
        }
      },
      {
        "op": "ephemeris.spkezr",
        "target": "100001",
        "observer": "0",
        "et": 25.25,
        "ref": "J2000",
        "abcorr": "NONE"
      },
      {
        "op": "ephemeris.spksfs",
        "body": 100001,
        "et": 25.25,
        "descrId": "WRITTEN"
      },
      {
        "op": "ephemeris.spkuds",
        "descrId": "WRITTEN"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
