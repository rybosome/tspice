        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H1",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKCLS_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
