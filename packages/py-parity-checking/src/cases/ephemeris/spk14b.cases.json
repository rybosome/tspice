  {
    "caseId": "ephemeris-spk14b-descriptor-and-coverage",
    "description": "The first begin supplies target, center, frame, segment identifier, two coverage endpoints and the degree used for both variable-width records.",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "file": {
          "kind": "scratch",
          "rel": "spk14b-descriptor-and-coverage.bsp"
        },
        "ifname": "AUTHORED TYPE 14",
        "ncomch": 0,
        "handleId": "H"
      },
      {
        "op": "ephemeris.spk14b",
        "handleId": "H",
        "segid": "STREAM",
        "body": 196014,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 12,
        "degree": 1
      },
      {
        "op": "ephemeris.spk14a",
        "handleId": "H",
        "count": 2,
        "records": [
          2, 2, 1, 2, 4, -1, 9, 0.25, -3, 0.5, 8, 1, 2, -2, 8, 4, 11, 3, -2, 2,
          1, 5, 3, 1, -4, 0.5, 6, 2
        ],
        "epochs": [0, 4]
      },
      {
        "op": "ephemeris.spk14e",
        "handleId": "H"
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "H"
      },
      {
        "op": "ephemeris.spkobj",
        "spk": {
          "kind": "scratch",
          "rel": "spk14b-descriptor-and-coverage.bsp"
        },
        "idsCellId": "I",
        "maxCardinality": 6
      },
      {
        "op": "ephemeris.spkcov",
        "spk": {
          "kind": "scratch",
          "rel": "spk14b-descriptor-and-coverage.bsp"
        },
        "idcode": 196014,
        "coverWindowId": "W",
        "maxIntervals": 8
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "scratch",
          "rel": "spk14b-descriptor-and-coverage.bsp"
        }
      },
      {
        "op": "ephemeris.spksfs",
        "body": 196014,
        "et": 0,
        "descrId": "D"
      },
      {
        "op": "ephemeris.spkuds",
        "descrId": "D"
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 196014,
        "et": 0,
        "ref": "J2000",
        "observer": 0
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 196014,
        "et": 2,
        "ref": "J2000",
        "observer": 0
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 196014,
        "et": 4,
        "ref": "J2000",
        "observer": 0
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 196014,
        "et": 8,
        "ref": "J2000",
        "observer": 0
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 196014,
        "et": 12,
        "ref": "J2000",
        "observer": 0
      }
