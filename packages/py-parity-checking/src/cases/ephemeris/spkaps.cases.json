      {
        "op": "ephemeris.spkaps",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
        "abcorr": "NONE",
        "observerState": [-40182, -14980, 27990, -1.43, 0.2, -0.06],
        "observerAcceleration": [0.0006, -0.0004, 0.0003]
      },
      {
        "op": "ephemeris.spkaps",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
