      {
        "op": "ephemeris.spksfs",
        "body": 100001,
        "et": 125,
        "descrId": "sel"
      },
      {
        "op": "ephemeris.spkpvn",
        "source": "sel",
        "descriptor": "sel",
        "et": 125,
        "mode": "borrowed"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
