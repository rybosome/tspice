[
  {
    "caseId": "ephemeris-spkpds-pack-descriptor-success",
    "description": "spkpds packs a segment descriptor for type-8 metadata",
    "workflow": [
      {
        "op": "ephemeris.spkpds",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "type": 8,
        "first": 0,
        "last": 120
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ephemeris-spkpds-invalid-frame-error",
    "description": "spkpds errors when the frame name is unknown",
    "workflow": [
      {
        "op": "ephemeris.spkpds",
        "body": 1000,
        "center": 0,
        "frame": "NOT_A_FRAME",
        "type": 8,
        "first": 0,
        "last": 120
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDREFFRAME"]
    }
  },
  {
    "caseId": "ephemeris-spkpds-audit-signed-negative-center",
    "description": "Signed instrument/negative center produce a legitimate NaN packed word. Compare all six integer fields rather than subnormal doubles.",
    "workflow": [
      {
        "op": "ephemeris.spkpds",
        "body": -123456,
        "center": -42,
        "frame": "ECLIPJ2000",
        "type": 8,
        "first": -123.5,
        "last": 456.75
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ephemeris-spkpds-audit-signed-limits-and-type-bounds",
    "description": "Valid descriptor type1000 is allowed without claiming an implementation of that planned segment routine; signed ID bounds and negative epochs retain exact fields.",
    "workflow": [
      {
        "op": "ephemeris.spkpds",
        "body": 2147483647,
        "center": -2147483648,
        "frame": "ECLIPJ2000",
