[
  {
    "caseId": "ephemeris-spkapp-geometric",
    "description": "Compare every output field for geometric corrections on the three-axis moving polynomial target.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris.bsp"
        }
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-observer.bsp"
        }
      },
      {
        "op": "ephemeris.spkapp",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
        "observerState": [-40182, -14980, 27990, -1.43, 0.2, -0.06],
        "abcorr": "NONE"
      },
      {
        "op": "ephemeris.spkapp",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
        "observerState": [-40182, -14980, 27990, -1.43, 0.2, -0.06],
        "abcorr": "none"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
