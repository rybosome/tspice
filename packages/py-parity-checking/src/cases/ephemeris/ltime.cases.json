[
  {
    "caseId": "ephemeris-ltime-transmission",
    "description": "Compare target epoch and positive elapsed light time with moving observer and target.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris.bsp"
        }
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-observer.bsp"
        }
      },
      {
        "op": "ephemeris.ltime",
        "etobs": -210.25,
        "observer": 100002,
        "dir": "->",
        "target": 100001
      },
      {
        "op": "ephemeris.ltime",
        "etobs": 150.5,
        "observer": 100002,
        "dir": "->",
        "target": 100001
      },
      {
        "op": "ephemeris.ltime",
        "etobs": 500.125,
        "observer": 100002,
        "dir": "->",
        "target": 100001
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
