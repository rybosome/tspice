        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-observer.bsp"
        }
      },
      {
        "op": "ephemeris.spkacs",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
        "abcorr": "NONE",
        "observer": 100002
      },
      {
        "op": "ephemeris.spkacs",
        "target": 100001,
        "et": 125.25,
        "ref": "J2000",
        "abcorr": "none",
        "observer": 100002
      }
    ],
    "expectation": {
      "kind": "success"
    }
