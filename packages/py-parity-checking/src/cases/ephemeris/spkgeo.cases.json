        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris-priority.bsp"
        }
      },
      {
        "op": "ephemeris.spkgeo",
        "et": 125.25,
        "target": 100001,
        "ref": "J2000",
        "observer": 100002
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-ephemeris-priority.bsp"
      },
      {
        "op": "ephemeris.spkgeo",
        "et": 125.25,
        "target": 100001,
        "ref": "J2000",
        "observer": 100002
      }
    ],
    "expectation": {
      "kind": "success"
    }
