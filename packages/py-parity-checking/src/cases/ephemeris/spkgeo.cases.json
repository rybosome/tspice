[
  {
    "caseId": "ephemeris-spkgeo-generated-segment-success",
    "description": "spkgeo returns geometric state/lt from generated SPK data",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "file": "kernels/ephemeris-spkgeo-happy.bsp",
        "ifname": "PARITY",
        "ncomch": 0,
        "handleId": "H1"
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "H1",
        "body": 1000,
        "center": 0,
        "frame": "J2000",
        "first": 0,
        "last": 120,
        "segid": "EPH_SPKGEO_SEG",
        "degree": 1,
        "states": [0, 0, 0, 1, 0, 0, 120, 0, 0, 1, 0, 0],
        "epoch1": 0,
        "step": 120
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "H1"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/ephemeris-spkgeo-happy.bsp"
      },
      {
        "op": "ephemeris.spkgeo",
        "target": 1000,
        "et": 60,
        "ref": "J2000",
        "observer": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
