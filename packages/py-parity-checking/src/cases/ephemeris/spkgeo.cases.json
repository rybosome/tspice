    "caseId": "ephemeris-spkgeo-audit-priority-restored",
    "description": "Read changed complete state after competing segment load and restore the original after unload",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "fixture",
          "rel": "kernels/audit-ephemeris.bsp"
        }
      },
      {
        "op": "ephemeris.spkgeo",
        "et": 125.25,
        "target": 100001,
        "ref": "J2000",
        "observer": 100002
