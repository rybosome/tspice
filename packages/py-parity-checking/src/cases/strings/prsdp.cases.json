[
  {
    "caseId": "strings-prsdp-grammar",
    "description": "Check decimal punctuation, exponent notation and implicit mantissa, including signed results.",
    "workflow": [
      {
        "op": "strings.prsdp",
        "input": " -1,234.75  "
      },
      {
        "op": "strings.prsdp",
        "input": "3.1 4"
      },
      {
        "op": "strings.prsdp",
        "input": "2.5D+1"
      },
      {
        "op": "strings.prsdp",
        "input": "-.75"
      },
      {
        "op": "strings.prsdp",
        "input": "E2"
      },
      {
        "op": "strings.prsdp",
        "input": "+12.2 e-1"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-prsdp-pi",
    "description": "Check mixed-case PI mnemonic and signed forms.",
    "workflow": [
      {
        "op": "strings.prsdp",
        "input": "PI"
      },
      {
        "op": "strings.prsdp",
        "input": "-pI"
      },
      {
        "op": "strings.prsdp",
        "input": "+Pi"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-prsdp-limits",
    "description": "Preserve defined numeric behavior at source-relevant magnitude limits.",
    "workflow": [
      {
        "op": "strings.prsdp",
        "input": "1D-307"
      },
      {
        "op": "strings.prsdp",
        "input": "-1.7E308"
      },
      {
        "op": "strings.prsdp",
        "input": "-0"
      },
      {
        "op": "strings.prsdp",
        "input": "12E-999"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-prsdp-invalid",
    "description": "Check the actual parser diagnostic and traced scientific failure.",
