        "op": "strings.cmprss",
        "delim": ":",
        "n": 1,
        "input": "\u00e9::\ud83d\ude00x",
        "lenout": 1
      },
      {
        "op": "strings.cmprss",
        "delim": ":",
        "n": 1,
        "input": "\u00e9::\ud83d\ude00x",
        "lenout": 3
      },
      {
        "op": "strings.cmprss",
        "delim": ":",
        "n": 1,
        "input": "\u00e9::\ud83d\ude00x",
        "lenout": 4
      },
      {
        "op": "strings.cmprss",
        "delim": ":",
        "n": 1,
        "input": "\u00e9::\ud83d\ude00x",
        "lenout": 8
      },
      {
        "op": "strings.cmprss",
        "delim": ":",
        "n": 1,
        "input": "\u00e9::\ud83d\ude00x",
        "lenout": 9
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-cmprss-zero-capacity-error",
    "description": "A nonpositive explicit capacity reaches the actual CSPICE STRINGTOOSHORT error.",
    "workflow": [
      {
        "op": "strings.cmprss",
        "delim": " ",
        "n": 1,
        "input": "abc",
        "lenout": 0
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["STRINGTOOSHORT"]
    }
  },
  {
    "caseId": "strings-cmprss-negative-capacity-error",
