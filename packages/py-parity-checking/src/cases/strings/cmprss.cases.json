        "n": 0,
        "input": "  AB\t "
      },
      {
        "op": "strings.cmprss",
        "delim": "\u0000",
        "n": 2,
        "input": "\u00e9.A. "
      },
      {
        "op": "strings.cmprss",
        "delim": "\u0000",
        "n": 0,
        "input": ""
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-cmprss-int32-capacity-limits",
