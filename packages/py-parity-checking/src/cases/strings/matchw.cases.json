  {
    "caseId": "strings-matchw-literal-case-and-order",
    "description": "Case-sensitive and insensitive routines see identical literal cases, transpositions and suffix differences.",
    "workflow": [
      {
        "op": "strings.matchw",
        "input": "Aqua",
        "template": "aQuA",
        "wstr": "*",
        "wchr": "?"
