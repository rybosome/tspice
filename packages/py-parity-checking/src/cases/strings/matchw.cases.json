        "input": "Aqua",
        "template": "Aqua",
        "wstr": "*",
        "wchr": "?"
      },
      {
        "op": "strings.matchw",
        "input": "Aqua",
        "template": "Auqa",
        "wstr": "*",
        "wchr": "?"
      },
      {
        "op": "strings.matchw",
        "input": "Aqua",
        "template": "Aqua!",
        "wstr": "*",
        "wchr": "?"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
