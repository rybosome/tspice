        "input": "#",
        "marker": "#",
        "value": true,
        "rtcase": "U"
      },
      {
        "op": "strings.repml",
        "input": "#",
        "marker": "#",
        "value": true,
        "rtcase": "l"
      },
      {
        "op": "strings.repml",
        "input": "#",
        "marker": "#",
        "value": true,
        "rtcase": "C"
      },
      {
        "op": "strings.repml",
        "input": "#",
        "marker": "#",
        "value": false,
        "rtcase": "U"
      },
      {
        "op": "strings.repml",
        "input": "#",
        "marker": "#",
        "value": false,
        "rtcase": "l"
      },
      {
        "op": "strings.repml",
        "input": "#",
        "marker": "#",
        "value": false,
        "rtcase": "C"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "strings-repml-invalid-case",
    "description": "The invalid case code signals even when the marker would not match.",
    "workflow": [
      {
        "op": "strings.repml",
        "input": "literal",
        "marker": "#",
        "value": true,
        "rtcase": "Z"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDCASE"]
