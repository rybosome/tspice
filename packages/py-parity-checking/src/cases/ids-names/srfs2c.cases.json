        "body": "EARTH"
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "ids-names.srfs2c",
        "surface": "alias",
        "body": "EARTH"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/surface-translation.tpc"
      },
      {
        "op": "ids-names.srfs2c",
        "surface": "alias",
        "body": "EARTH"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
