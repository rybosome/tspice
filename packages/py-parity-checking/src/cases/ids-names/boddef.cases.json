[
  {
    "caseId": "ids-names-boddef-round-trip-success",
    "description": "boddef mapping can be resolved by bods2c and bodc2s in the same workflow",
    "workflow": [
      {
        "op": "ids-names.boddef",
        "name": "TSPICE_PARITY_BODY_639",
        "code": 123456789
      },
      {
        "op": "ids-names.bods2c",
        "name": "TSPICE_PARITY_BODY_639"
      },
      {
        "op": "ids-names.bodc2s",
        "code": 123456789
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ids-names-boddef-empty-name-error",
    "description": "Representative boddef validation error for empty body name",
    "workflow": [
      {
        "op": "ids-names.boddef",
        "name": "",
        "code": 10
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["EMPTYSTRING"]
    }
  },
  {
    "caseId": "ids-names-boddef-audit-name-reassignment-and-pool-precedence",
    "description": "boddef: name reassignment and pool precedence, compare complete live SpiceyPy results/effects",
    "workflow": [
      {
        "op": "ids-names.boddef",
        "name": "Audit Reassign",
        "code": -123450101
      },
      {
        "op": "ids-names.boddef",
        "name": "Audit Reassign",
        "code": -123450102
      },
      {
        "op": "ids-names.bodc2n",
        "code": -123450101
      },
      {
        "op": "ids-names.bodc2n",
        "code": -123450102
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "NAIF_BODY_NAME",
        "values": ["Audit Priority"]
      },
      {
        "op": "kernel-pool.pipool",
        "name": "NAIF_BODY_CODE",
        "values": [-123450103]
      },
      {
        "op": "ids-names.boddef",
        "name": "Audit Priority",
        "code": -123450104
      },
      {
        "op": "ids-names.bodn2c",
        "name": "Audit Priority"
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "ids-names.bodn2c",
        "name": "Audit Priority"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
