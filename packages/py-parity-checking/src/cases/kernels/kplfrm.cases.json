    }
  },
  {
    "caseId": "kernels-kplfrm-all-inertial-unload-success",
    "description": "All classes (-1) includes the loaded pool frame; inertial class is empty, and unloading removes it",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/kplfrm-minimal.tf"
      },
      {
        "op": "kernels.kplfrm",
        "frmcls": -1
      },
      {
        "op": "kernels.kplfrm",
        "frmcls": 1
      },
      {
        "op": "kernels.unload",
        "path": "kernels/kplfrm-minimal.tf"
      },
      {
        "op": "kernels.kplfrm",
        "frmcls": 4
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "kernels-kplfrm-empty-pool-success",
    "description": "No loaded frame specifications yields empty sets across repeated calls",
    "workflow": [
      {
        "op": "kernels.kplfrm",
        "frmcls": 4
      },
      {
        "op": "kernels.kplfrm",
        "frmcls": -1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "kernels-kplfrm-set-too-small-error",
    "description": "A real integer cell with zero capacity cannot hold the loaded frame set",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/kplfrm-minimal.tf"
      },
      {
        "op": "kernels.kplfrm",
        "frmcls": 4,
        "capacity": 0
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["SETTOOSMALL"]
    }
  }
