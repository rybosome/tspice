      "errorMessageIncludes": ["NUMBEREXPECTED"]
    }
  },
  {
    "caseId": "kernels-furnsh-audit-observable-pool-values",
    "description": "Loading the corrected authored text fixture must populate actual numeric, integer and character pool values.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/kernel-pool-parity.tpc"
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "TSPICE_PARITY_DOUBLE_VAR",
        "start": 0,
        "room": 4
      },
      {
        "op": "kernel-pool.gipool",
        "name": "TSPICE_PARITY_INT_VAR",
        "start": 0,
        "room": 4
      },
      {
        "op": "kernel-pool.gcpool",
        "name": "TSPICE_PARITY_CHAR_VAR",
        "start": 0,
        "room": 4
      }
    ],
    "expectation": {
      "kind": "success"
    }
  }
]
