        "op": "kernel-pool.dtpool",
        "name": "KP_DT_CHAR"
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "KP_DT_NUM"
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "KP_DT_MISSING"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
