  {
    "caseId": "kernel-pool-stpool-missing-type-and-index",
    "description": "Missing variables, numeric values and out-of-range positive/negative ordinals have distinct setup and normal absence.",
    "workflow": [
      {
        "op": "kernel-pool.stpool",
        "item": "B05_JOIN",
        "nth": 0,
        "contin": "+",
        "lenout": 9
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "B05_JOIN",
        "values": [2, 5]
      },
      {
        "op": "kernel-pool.stpool",
        "item": "B05_JOIN",
        "nth": 0,
        "contin": "+",
        "lenout": 9
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "B05_JOIN",
        "values": ["a", "b"]
      },
      {
        "op": "kernel-pool.stpool",
        "item": "B05_JOIN",
        "nth": -1,
        "contin": "+",
        "lenout": 9
      },
      {
        "op": "kernel-pool.stpool",
        "item": "B05_JOIN",
        "nth": 2147483646,
        "contin": "+",
        "lenout": 9
      },
      {
        "op": "kernel-pool.stpool",
        "item": "B05_JOIN",
        "nth": 1,
        "contin": "+",
        "lenout": 9
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
