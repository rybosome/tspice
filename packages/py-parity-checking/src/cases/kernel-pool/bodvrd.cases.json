[
  {
    "caseId": "kernel-pool-bodvrd-exact-and-oversized",
    "description": "Read actual cardinality and every numeric value at exact and larger caller capacity.",
    "workflow": [
      {
        "op": "kernel-pool.ldpool",
        "file": "kernels/audit-pool-operations.tpc"
      },
      {
        "op": "kernel-pool.bodvrd",
        "body": "earth",
        "item": "B05",
        "maxn": 4
      },
      {
        "op": "kernel-pool.bodvrd",
        "body": "earth",
        "item": "B05",
        "maxn": 12
      },
      {
        "op": "kernel-pool.bodvrd",
        "body": "earth",
        "item": "b05",
        "maxn": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "kernel-pool-bodvrd-replacement-and-ownership",
    "description": "Replace a numeric item with a shorter item and drain the active dimensions again.",
    "workflow": [
      {
        "op": "kernel-pool.ldpool",
        "file": "kernels/audit-pool-operations.tpc"
      },
      {
        "op": "kernel-pool.bodvrd",
        "body": "earth",
        "item": "B05",
        "maxn": 4
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY399_B05",
        "values": [-8.25]
      },
      {
        "op": "kernel-pool.bodvrd",
        "body": "earth",
        "item": "B05",
        "maxn": 4
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
