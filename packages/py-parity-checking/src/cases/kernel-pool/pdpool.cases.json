      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 3
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "AUDIT",
        "values": [1.25, -3.5]
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 8
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "AUDIT"
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "AUDIT",
        "values": []
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 8
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "AUDIT"
      }
    ],
    "expectation": {
      "kind": "success"
    }
