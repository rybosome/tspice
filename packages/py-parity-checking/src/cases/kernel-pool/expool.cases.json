        "values": ["x"]
      },
      {
        "op": "kernel-pool.expool",
        "name": "KP_EX_NUM"
      },
      {
        "op": "kernel-pool.expool",
        "name": "KP_EX_CHAR"
      },
      {
        "op": "kernel-pool.expool",
        "name": "KP_EX_MISSING"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
