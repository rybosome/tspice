      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "=",
        "size": 4,
        "divby": 1,
        "type": "N"
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "B05_NUM",
        "values": ["blue", "green"]
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "=",
        "size": 2,
        "divby": 1,
        "type": "c"
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "B05_NUM"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
