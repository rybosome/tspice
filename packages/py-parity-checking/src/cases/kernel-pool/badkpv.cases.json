[
  {
    "caseId": "kernel-pool-badkpv-comparison-operators",
    "description": "Test all five canonical dimension comparisons, case-insensitive type and signed divisors.",
    "workflow": [
      {
        "op": "kernel-pool.pdpool",
        "name": "B05_NUM",
        "values": [3, -2.25, 4.125, 0]
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "=",
        "size": 4,
        "divby": 2,
        "type": "N"
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "<",
        "size": 5,
        "divby": -2,
        "type": "n"
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": ">",
        "size": 3,
        "divby": 4,
        "type": "N"
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "<=",
        "size": 4,
        "divby": 1,
        "type": "n"
      },
      {
        "op": "kernel-pool.badkpv",
        "caller": "B05_CALLER",
        "name": "B05_NUM",
        "comp": "=>",
        "size": 4,
        "divby": 2,
        "type": "N"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "kernel-pool-badkpv-changing-pool-type",
    "description": "Validate successive independent numeric and character definitions of the same variable.",
    "workflow": [
      {
        "op": "kernel-pool.pdpool",
        "name": "B05_NUM",
        "values": [3, -2.25, 4.125, 0]
