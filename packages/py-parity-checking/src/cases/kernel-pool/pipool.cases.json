        "name": "AUDIT",
        "values": [17]
      },
      {
        "op": "kernel-pool.pipool",
        "name": "AUDIT",
        "values": []
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "AUDIT"
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 3
      },
      {
        "op": "kernel-pool.pipool",
        "name": "AUDIT",
        "values": [-2147483648, 2147483647]
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 8
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "AUDIT"
      },
      {
        "op": "kernel-pool.pipool",
        "name": "AUDIT",
        "values": []
      },
      {
        "op": "kernel-pool.gdpool",
        "name": "AUDIT",
        "start": 0,
        "room": 8
      },
      {
        "op": "kernel-pool.dtpool",
        "name": "AUDIT"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "kernel-pool-pipool-audit-long-variable-name",
    "description": "pipool: long variable name, observe actual pool contents or notification flags with live SpiceyPy",
    "workflow": [
