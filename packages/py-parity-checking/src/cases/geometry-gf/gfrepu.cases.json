[
  {
    "caseId": "geometry-gf-gfrepu-prior-no-init",
    "description": "Run a valid update with no initialized work measure.",
    "workflow": [
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": -5,
        "ivend": 10,
        "time": 3
      },
      {
        "op": "error.failed"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-gf-gfrepu-endpoints",
    "description": "Report both exact endpoints and a midpoint.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "c",
        "left": -10,
        "right": 10,
        "maxIntervals": 4
      },
      {
        "op": "geometry-gf.gfrepi",
        "windowId": "c",
        "begmss": "GF search",
        "endmss": "done"
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": -10,
        "ivend": 10,
        "time": -10
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": -10,
        "ivend": 10,
        "time": 0
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": -10,
        "ivend": 10,
        "time": 10
      },
      {
        "op": "geometry-gf.gfrepf"
      },
      {
        "op": "error.failed"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-gf-gfrepu-reverse-time",
