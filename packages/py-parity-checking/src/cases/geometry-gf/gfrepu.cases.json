        "ivbeg": 0,
        "ivend": 4,
        "time": 3
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": 0,
        "ivend": 4,
        "time": 1
      },
      {
        "op": "geometry-gf.gfrepu",
