  {
    "caseId": "geometry-gf-gfrepu-reinitialize",
    "description": "Restart the reporter and update a fresh enclosing window.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "c",
        "left": 0,
        "right": 10,
        "maxIntervals": 4
      },
      {
        "op": "geometry-gf.gfrepi",
        "windowId": "c",
        "begmss": "First",
        "endmss": "done"
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": 0,
        "ivend": 10,
        "time": 2
      },
      {
        "op": "geometry-gf.gfrepf"
      },
      {
        "op": "geometry-gf.gfrepi",
        "windowId": "c",
        "begmss": "Second",
        "endmss": "done"
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": 0,
        "ivend": 10,
        "time": 7
      },
      {
        "op": "geometry-gf.gfrepf"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-gf-gfrepu-interrupt",
    "description": "Reporting a progress increment preserves a previously raised GF flag.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "c",
        "left": 0,
        "right": 20,
        "maxIntervals": 4
      },
      {
        "op": "geometry-gf.gfrepi",
        "windowId": "c",
        "begmss": "GF search",
        "endmss": "done"
      },
      {
        "op": "geometry-gf.gfinth",
        "sigcode": 2
      },
      {
        "op": "geometry-gf.gfrepu",
        "ivbeg": 0,
        "ivend": 20,
        "time": 5
      },
      {
        "op": "geometry-gf.gfbail"
      },
      {
        "op": "geometry-gf.gfrepf"
      },
      {
        "op": "geometry-gf.gfclrh"
      },
      {
        "op": "geometry-gf.gfbail"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
