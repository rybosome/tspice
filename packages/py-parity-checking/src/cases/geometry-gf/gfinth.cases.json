  {
    "caseId": "geometry-gf-gfinth-rearm",
    "description": "A repeated explicit SIGINT preserves the flag until cleared.",
    "workflow": [
      {
        "op": "geometry-gf.gfclrh"
      },
      {
        "op": "geometry-gf.gfinth",
        "sigcode": 2
      },
      {
        "op": "geometry-gf.gfbail"
      },
      {
        "op": "geometry-gf.gfinth",
        "sigcode": 2
      },
      {
        "op": "geometry-gf.gfbail"
      },
      {
        "op": "geometry-gf.gfclrh"
      },
      {
        "op": "geometry-gf.gfbail"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-gf-gfinth-resets",
    "description": "GF receipt survives both error and kernel resets.",
    "workflow": [
      {
        "op": "geometry-gf.gfinth",
        "sigcode": 2
      },
      {
        "op": "error.reset"
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "geometry-gf.gfbail"
      },
      {
        "op": "geometry-gf.gfclrh"
      },
      {
        "op": "geometry-gf.gfbail"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
