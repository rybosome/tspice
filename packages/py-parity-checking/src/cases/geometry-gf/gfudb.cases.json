[
  {
    "caseId": "geometry-gf-gfudb-two-true-regions",
    "description": "The square-above-one predicate calls its supplied scalar and finds two separated regions.",
    "workflow": [
      {
        "op": "geometry-gf.gfstol",
        "value": 1e-6
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "c",
        "left": -3,
        "right": 3,
        "maxIntervals": 8
      },
      {
        "op": "geometry-gf.gfudb",
        "scalar": "square",
        "step": 0.25,
        "cnfineWindowId": "c",
        "resultWindowId": "r",
        "resultMaxIntervals": 8,
        "predicate": "above",
        "threshold": 1
      },
      {
        "op": "geometry-gf.gfudb",
        "scalar": "square",
        "step": 0.25,
        "cnfineWindowId": "c",
        "resultWindowId": "r",
        "resultMaxIntervals": 8,
        "predicate": "below",
        "threshold": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
