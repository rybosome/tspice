[
  {
    "caseId": "geometry-gf-gfstol-success",
    "description": "Observe actual coarse/fine search endpoints; GFREFN alone cannot establish tolerance effects",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "TOL_C",
        "left": -2000,
        "right": 0,
        "maxIntervals": 8
      },
      {
        "op": "geometry-gf.gfstol",
        "value": 0.5
      },
      {
        "op": "geometry-gf.gfdist",
        "target": "100101",
        "abcorr": "NONE",
        "obsrvr": "100102",
        "relate": "<",
        "refval": 10,
        "adjust": 0,
        "step": 25,
        "nintvls": 100,
        "cnfineWindowId": "TOL_C",
        "resultWindowId": "TOL_R",
        "resultMaxIntervals": 8
      },
      {
        "op": "geometry-gf.gfstol",
        "value": 1e-12
      },
      {
        "op": "geometry-gf.gfdist",
        "target": "100101",
        "abcorr": "NONE",
        "obsrvr": "100102",
        "relate": "<",
        "refval": 10,
        "adjust": 0,
        "step": 25,
        "nintvls": 100,
        "cnfineWindowId": "TOL_C",
        "resultWindowId": "TOL_R",
        "resultMaxIntervals": 8
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-gf-gfstol-invalid-value-error",
    "description": "Representative gfstol invalid tolerance error",
    "workflow": [
      {
        "op": "geometry-gf.gfstol",
        "value": -1
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDTOLERANCE"]
    }
  },
  {
    "caseId": "geometry-gf-gfstol-audit-zero",
    "description": "Require actual INVALIDTOLERANCE",
    "workflow": [
      {
        "op": "geometry-gf.gfstol",
        "value": 0
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDTOLERANCE"]
    }
  },
  {
    "caseId": "geometry-gf-gfstol-audit-kernel-clear-persistence",
