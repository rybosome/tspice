      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "TOL_C",
        "left": -2000,
        "right": 0,
        "maxIntervals": 8
      },
      {
        "op": "geometry-gf.gfstol",
        "value": 0.5
      },
      {
        "op": "geometry-gf.gfdist",
        "target": "100101",
        "abcorr": "NONE",
        "obsrvr": "100102",
        "relate": "<",
        "refval": 10,
        "adjust": 0,
        "step": 25,
        "nintvls": 100,
        "cnfineWindowId": "TOL_C",
        "resultWindowId": "TOL_R",
        "resultMaxIntervals": 8
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
