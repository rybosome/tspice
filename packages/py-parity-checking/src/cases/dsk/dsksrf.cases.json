  {
    "caseId": "dsk-dsksrf-audit-union-duplicates-and-repeat",
    "description": "Actual caller-owned cell union preserves initial IDs, adds missing IDs, sorts/deduplicates repeated segment IDs and remains idempotent on a second call; every snapshot is compared.",
    "workflow": [
      {
        "op": "dsk.dsksrf",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-multi-dsk.bds"
        },
        "bodyid": 399,
        "cellSize": 10,
        "initial": [72, -5, 72],
        "repetitions": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "dsk-dsksrf-audit-empty-zero-capacity",
    "description": "A valid empty DSK and an actual zero-capacity output cell return an empty set; Python must not substitute a default large cell.",
    "workflow": [
      {
        "op": "dsk.dsksrf",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-empty-dsk.bds"
        },
        "bodyid": 399,
        "cellSize": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "dsk-dsksrf-audit-small-capacity",
    "description": "A real two-ID result overflows capacity1 and must signal actual CELLTOOSMALL; contents after toolkit failure are not assumed unchanged.",
    "workflow": [
      {
        "op": "dsk.dsksrf",
        "path": {
          "kind": "fixture",
