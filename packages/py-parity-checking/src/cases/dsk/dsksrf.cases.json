        },
        "bodyid": 399
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["FILENOTFOUND"]
    }
  },
  {
    "caseId": "dsk-dsksrf-audit-wrong-das-file-type",
    "description": "An actual closed DAS/DLA file has the right architecture but wrong type; query must reach INVALIDFILETYPE.",
    "workflow": [
      {
        "op": "file-io.dlaopn",
        "handleId": "non-dsk",
        "path": {
          "kind": "scratch",
          "rel": "dsksrf-wrong-type.dla"
        },
        "ftype": "DLA",
        "ifname": "AUTHORED_NON_DSK",
        "ncomch": 0
      },
      {
        "op": "file-io.dlacls",
        "handleId": "non-dsk"
      },
      {
        "op": "dsk.dsksrf",
        "path": {
          "kind": "scratch",
          "rel": "dsksrf-wrong-type.dla"
        },
        "bodyid": 399
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDFILETYPE"]
    }
  },
