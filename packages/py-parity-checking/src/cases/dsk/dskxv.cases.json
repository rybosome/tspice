  {
    "caseId": "dsk-dskxv-closest-overlap",
    "description": "Unprioritized rays choose the closest geometry across two concentric surfaces independent of list order.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bds"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-dsk-ray-outer.bds"
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [101],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [101, 102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [102, 101],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      },
      {
        "op": "dsk.dskxv",
        "pri": false,
        "target": "100101",
        "srflst": [102, 102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertices": [
          [10, 1, 0.25],
          [10, 1, 0.25]
        ],
        "dirs": [
          [-1, 0, 0],
          [1, 0, 0]
        ]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
