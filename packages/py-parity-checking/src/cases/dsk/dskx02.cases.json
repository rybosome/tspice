        "dladscId": "d"
      },
      {
        "op": "dsk.dskx02",
        "handleId": "h",
        "dladscId": "d",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0]
      },
      {
        "op": "dsk.dskx02",
        "handleId": "h",
