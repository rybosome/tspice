        "vertex": [-10, -1, -0.25],
        "raydir": [1, 0, 0]
      },
      {
        "op": "dsk.dskx02",
        "handleId": "h",
        "dladscId": "d",
        "vertex": [0.25, 0.25, 3],
        "raydir": [0, 0, -2]
      },
      {
        "op": "dsk.dascls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
