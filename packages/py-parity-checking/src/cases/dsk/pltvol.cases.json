[
  {
    "caseId": "dsk-pltvol-signed-orientation",
    "description": "A closed tetrahedron has opposite signed volumes when all face windings reverse.",
    "workflow": [
      {
        "op": "dsk.pltvol",
        "vertices": [0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4],
        "plates": [1, 3, 2, 1, 2, 4, 1, 4, 3, 2, 3, 4]
      },
      {
        "op": "dsk.pltvol",
        "vertices": [0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4],
        "plates": [1, 2, 3, 1, 4, 2, 1, 3, 4, 2, 4, 3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "dsk-pltvol-translation-and-scale",
    "description": "Volume of the closed polyhedron survives translation and scales cubically.",
