      },
      {
        "op": "dsk.pltvol",
        "vertices": [
          0.0, 0.0, 0.0, 0.25, 0.0, 0.0, 0.0, 0.375, 0.0, 0.0, 0.0, 0.5
        ],
        "plates": [1, 3, 2, 1, 2, 4, 1, 4, 3, 2, 3, 4]
      },
      {
        "op": "dsk.pltvol",
        "vertices": [
          0.0, 0.0, 0.0, 2000.0, 0.0, 0.0, 0.0, 3000.0, 0.0, 0.0, 0.0, 4000.0
        ],
        "plates": [1, 2, 3, 1, 4, 2, 1, 3, 4, 2, 4, 3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "dsk-pltvol-coplanar-and-repeated",
