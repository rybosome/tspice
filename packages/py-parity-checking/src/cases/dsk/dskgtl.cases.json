  {
    "caseId": "dsk-dskgtl-kclear-persistence",
    "description": "Verify a deliberate small tolerance survives KEEPER kclear, then restore and observe its ordinary default.",
    "workflow": [
      {
        "op": "dsk.dskstl",
        "key": 1,
        "value": 2e-10
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "dsk.dskgtl",
        "key": 1
      },
      {
        "op": "dsk.dskstl",
        "key": 1,
        "value": 1e-10
      },
      {
        "op": "dsk.dskgtl",
        "key": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
