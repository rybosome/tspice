        "pri": false,
        "target": "100101",
        "srflst": [102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0],
        "maxd": 1,
        "maxi": 1
      },
      {
        "op": "dsk.dskxsi",
        "pri": false,
        "target": "100101",
        "srflst": [101, 102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0],
        "maxd": 1,
        "maxi": 1
      },
      {
        "op": "dsk.dskxsi",
        "pri": false,
        "target": "100101",
        "srflst": [102, 101],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0],
        "maxd": 1,
        "maxi": 1
      },
      {
        "op": "dsk.dskxsi",
        "pri": false,
        "target": "100101",
        "srflst": [102, 102],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0],
        "maxd": 1,
        "maxi": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
