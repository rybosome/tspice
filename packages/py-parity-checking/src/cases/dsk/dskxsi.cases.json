  {
    "caseId": "dsk-dskxsi-closest-overlap",
    "description": "Unprioritized rays choose the closest geometry across two concentric surfaces independent of list order.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bds"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-dsk-ray-outer.bds"
      },
      {
        "op": "dsk.dskxsi",
        "pri": false,
        "target": "100101",
        "srflst": [],
        "et": 0.0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "vertex": [10, 1, 0.25],
        "raydir": [-1, 0, 0],
        "maxd": 1,
        "maxi": 1
      },
      {
        "op": "dsk.dskxsi",
        "pri": false,
        "target": "100101",
        "srflst": [101],
        "et": 0.0,
