[
  {
    "caseId": "dsk-illum_pl02-geometry",
    "description": "Compare complete physical results for a moving observer at separated signed epochs.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-legacy-plates.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "dsk.dasopr",
        "handleId": "h",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-legacy-plates.bds"
        }
      },
      {
        "op": "dsk.dlabfs",
        "handleId": "h",
        "dladscId": "d"
      },
      {
        "op": "dsk.illum_pl02",
        "handleId": "h",
        "dladscId": "d",
        "target": "100101",
        "et": -47,
        "abcorr": "NONE",
        "obsrvr": "100102",
        "spoint": [1.0, 0.6666666666666666, 0.3333333333333333]
      },
      {
        "op": "dsk.illum_pl02",
        "handleId": "h",
        "dladscId": "d",
        "target": "100101",
        "et": 31,
        "abcorr": "NONE",
        "obsrvr": "100102",
        "spoint": [1.0, 0.6666666666666666, 0.3333333333333333]
      },
      {
        "op": "dsk.dascls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
