[
  {
    "caseId": "file-io-dafopw-scratch-reopen-read",
    "description": "Open a generated SPK for write, navigate its array, close, and reopen the same file for read.",
    "workflow": [
      {
        "op": "ephemeris.spkopn",
        "handleId": "creator",
        "file": {
          "kind": "scratch",
          "rel": "c01-readback.bsp"
        },
        "ifname": "TSPICE C01",
        "ncomch": 0
      },
      {
        "op": "ephemeris.spkw08",
        "handleId": "creator",
        "body": -777777,
        "center": -99,
        "frame": "J2000",
        "first": -1,
        "last": 1,
        "segid": "C01 Writeable DAF 08",
        "degree": 1,
        "states": [1, 2, 3, 4, 5, 6, 2, 3, 4, 5, 6, 7],
        "epoch1": -1,
        "step": 2
      },
      {
        "op": "ephemeris.spkcls",
        "handleId": "creator"
      },
      {
        "op": "file-io.dafopw",
        "handleId": "a",
        "path": {
          "kind": "scratch",
          "rel": "c01-readback.bsp"
        }
      },
      {
        "op": "file-io.dafhsf",
        "handleId": "a"
      },
      {
        "op": "file-io.dafbbs",
        "handleId": "a"
      },
      {
        "op": "file-io.daffpa",
        "handleId": "a"
      },
      {
        "op": "file-io.dafgn",
        "handleId": "a"
      },
      {
        "op": "file-io.dafgs",
        "handleId": "a"
      },
      {
        "op": "file-io.dafcls",
        "handleId": "a"
      },
      {
        "op": "file-io.dafopr",
        "handleId": "reader",
        "path": {
          "kind": "scratch",
          "rel": "c01-readback.bsp"
        }
      },
      {
        "op": "file-io.dafbfs",
        "handleId": "reader"
      },
      {
        "op": "file-io.daffna",
        "handleId": "reader"
      },
      {
        "op": "file-io.dafgn",
        "handleId": "reader"
      },
      {
        "op": "file-io.dafgs",
        "handleId": "reader"
      },
      {
        "op": "file-io.dafcls",
        "handleId": "reader"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
