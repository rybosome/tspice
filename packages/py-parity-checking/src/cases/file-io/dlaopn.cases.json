[
  {
    "caseId": "file-io-dlaopn-create-empty-file-success",
    "description": "dlaopn creates an empty DLA file and dlabfs reports no segments",
    "workflow": [
      {
        "op": "file-io.dlaopn",
        "path": {
          "kind": "scratch",
          "rel": "dlaopn-create.dla"
        },
        "ftype": "DLA",
        "ifname": "TSPICE",
        "ncomch": 0,
        "handleId": "writer"
      },
      {
        "op": "file-io.dlabfs",
        "handleId": "writer",
        "descrId": "seg0"
      },
      {
        "op": "file-io.dlacls",
        "handleId": "writer"
      },
      {
        "op": "file-io.exists",
        "path": {
          "kind": "scratch",
          "rel": "dlaopn-create.dla"
        }
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
