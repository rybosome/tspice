[
  {
    "caseId": "file-io-dascls-closes-dla-handle-success",
    "description": "dascls closes a handle returned by dlaopn",
    "workflow": [
      {
        "op": "file-io.dlaopn",
        "path": {
          "kind": "scratch",
          "rel": "dascls-close.dla"
        },
        "ftype": "DLA",
        "ifname": "TSPICE",
        "ncomch": 0,
        "handleId": "writer"
      },
      {
        "op": "file-io.dascls",
        "handleId": "writer"
      },
      {
        "op": "file-io.exists",
        "path": {
          "kind": "scratch",
          "rel": "dascls-close.dla"
        }
      },
      {
        "op": "file-io.dasopr",
        "handleId": "verify",
        "path": {
          "kind": "scratch",
          "rel": "dascls-close.dla"
        }
      },
      {
        "op": "file-io.dlabfs",
        "handleId": "verify",
        "descrId": "empty"
      },
      {
        "op": "file-io.dlacls",
        "handleId": "verify"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "file-io-dascls-double-close-error",
    "description": "Representative dascls double-close error",
    "workflow": [
      {
        "op": "file-io.dlaopn",
        "path": {
          "kind": "scratch",
          "rel": "dascls-double-close.dla"
        },
        "ftype": "DLA",
        "ifname": "TSPICE",
        "ncomch": 0,
        "handleId": "writer"
      },
      {
        "op": "file-io.dlacls",
        "handleId": "writer"
      },
      {
        "op": "file-io.dasopr",
        "path": {
          "kind": "scratch",
          "rel": "dascls-double-close.dla"
        },
        "handleId": "reader"
      },
      {
        "op": "file-io.dascls",
        "handleId": "reader"
      },
      {
        "op": "file-io.dascls",
        "handleId": "reader"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["closed"]
    }
  }
]
