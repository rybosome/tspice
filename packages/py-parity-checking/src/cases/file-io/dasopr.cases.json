[
  {
    "caseId": "file-io-dasopr-open-empty-dla-success",
    "description": "dasopr opens a DLA-backed DAS file and dlabfs reports no segments",
    "workflow": [
      {
        "op": "file-io.dlaopn",
        "path": "kernels/generated/dasopr-open.dla",
        "ftype": "DLA",
        "ifname": "TSPICE",
        "ncomch": 0,
        "handleId": "writer"
      },
      { "op": "file-io.dlacls", "handleId": "writer" },
      { "op": "file-io.dasopr", "path": "kernels/generated/dasopr-open.dla", "handleId": "reader" },
      { "op": "file-io.dlabfs", "handleId": "reader", "descrId": "seg0" },
      { "op": "file-io.dascls", "handleId": "reader" }
    ],
    "expectation": { "kind": "success" }
  },
  {
    "caseId": "file-io-dasopr-missing-file-error",
    "description": "Representative dasopr missing-file error",
    "workflow": [{ "op": "file-io.dasopr", "path": "kernels/missing-das.dla", "handleId": "das" }],
    "expectation": { "kind": "error" }
  }
]
