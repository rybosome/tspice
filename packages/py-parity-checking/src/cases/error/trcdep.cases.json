[
  {
    "caseId": "error-trcdep-nested",
    "description": "Observe live error status or complete current trace at distinct depths, after a pop, after a captured signal and after a toolkit reset.",
    "workflow": [
      {
        "op": "error.chkin",
        "name": "OUTER"
      },
      {
        "op": "error.trcdep"
      },
      {
        "op": "error.chkin",
        "name": "Inner Module"
      },
      {
        "op": "error.trcdep"
      },
      {
        "op": "error.sigerr",
        "short": "SPICE(OBSERVED)",
        "capture": true
      },
      {
        "op": "error.trcdep"
      },
      {
        "op": "error.chkout",
        "name": "Inner Module"
      },
      {
        "op": "error.trcdep"
      },
      {
        "op": "error.reset"
      },
      {
        "op": "error.trcdep"
      },
      {
        "op": "error.chkout",
        "name": "OUTER"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
