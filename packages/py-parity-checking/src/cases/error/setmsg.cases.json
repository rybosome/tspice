[
  {
    "caseId": "error-setmsg-long-roundtrip-success",
    "description": "setmsg updates the LONG message buffer",
    "workflow": [
      {
        "op": "error.reset"
      },
      {
        "op": "error.setmsg",
        "message": "setmsg parity message"
      },
      {
        "op": "error.getmsg",
        "which": "LONG"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "error-setmsg-empty-message-error",
    "description": "Representative setmsg empty-string error path",
    "workflow": [
      {
        "op": "error.setmsg",
        "message": ""
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["EMPTYSTRING"]
    }
  },
  {
    "caseId": "error-setmsg-audit-replace-and-leading-blanks",
    "description": "Long messages preserve leading blanks and replacement; messages alone do not set failure.",
    "workflow": [
      {
        "op": "error.setmsg",
        "message": "discard this first message"
      },
      {
        "op": "error.getmsg",
        "which": "LONG"
      },
      {
        "op": "error.setmsg",
        "message": "  preserve leading blanks\nand internal newline"
      },
      {
        "op": "error.getmsg",
        "which": "LONG"
      },
      {
        "op": "error.failed"
      },
      {
        "op": "error.sigerr",
        "short": "SPICE(AUDITLONG)",
        "capture": true
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "error-setmsg-audit-long-buffer-boundary",
    "description": "A 1900-character authored ASCII message is truncated to CSPICE's 1840-character LONG buffer; the entire buffer reaches the comparison.",
    "workflow": [
      {
        "op": "error.setmsg",
        "message": ""
      },
      {
        "op": "error.getmsg",
        "which": "LONG"
      },
      {
        "op": "error.sigerr",
        "short": "SPICE(AUDITLONGBUF)",
        "capture": true
      }
    ],
    "expectation": {
      "kind": "success"
    }
  }
]
