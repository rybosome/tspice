[
  {
    "caseId": "error-qcktrc-nested",
    "description": "Observe live error status or complete current trace at distinct depths, after a pop, after a captured signal and after a toolkit reset.",
    "workflow": [
      {
        "op": "error.chkin",
        "name": "OUTER"
      },
      {
        "op": "error.qcktrc"
      },
      {
        "op": "error.chkin",
        "name": "Inner Module"
      },
      {
        "op": "error.qcktrc"
      },
      {
        "op": "error.sigerr",
        "short": "SPICE(OBSERVED)",
        "capture": true
      },
      {
        "op": "error.qcktrc"
      },
      {
        "op": "error.chkout",
        "name": "Inner Module"
      },
      {
        "op": "error.qcktrc"
      },
      {
        "op": "error.reset"
      },
      {
        "op": "error.qcktrc"
      },
      {
        "op": "error.chkout",
        "name": "OUTER"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "error-qcktrc-byte-capacity",
    "description": "Observe the single-byte and full-name capacities independently, with UTF-8 and significant trailing tab.",
    "workflow": [
      {
        "op": "error.chkin",
        "name": "ABé\t"
      },
      {
        "op": "error.qcktrc",
        "tracelen": 2
      },
      {
        "op": "error.qcktrc",
        "tracelen": 5
      },
      {
        "op": "error.qcktrc",
        "tracelen": 6
      },
      {
        "op": "error.qcktrc",
        "tracelen": 2147483647
      },
      {
        "op": "error.chkout",
        "name": "ABé\t"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "error-qcktrc-length-1",
    "description": "Retain the original output-length diagnostic before indexing or writing.",
    "workflow": [
      {
        "op": "error.qcktrc",
        "tracelen": 1
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["SPICE(STRINGTOOSHORT)"]
    }
  },
  {
    "caseId": "error-qcktrc-length--3",
    "description": "Retain the original output-length diagnostic before indexing or writing.",
    "workflow": [
