  {
    "caseId": "coords-vectors-drdpgr-mixed-positions",
    "description": "Compare all nine derivative entries at three asymmetric locations, including both signs and unequal angular and distance derivatives.",
    "workflow": [
      {
        "op": "coords-vectors.drdpgr",
        "body": "EARTH",
        "lon": 0.7,
        "lat": -0.45,
        "alt": 1.6,
        "re": 3.0,
        "f": 0.125
      },
      {
        "op": "coords-vectors.drdpgr",
        "body": "EARTH",
        "lon": -1.2,
        "lat": 0.4,
        "alt": -0.25,
        "re": 3.0,
        "f": 0.125
      },
      {
        "op": "coords-vectors.drdpgr",
        "body": "EARTH",
        "lon": 0.2,
        "lat": 0.25,
        "alt": 0,
        "re": 3.0,
        "f": 0.125
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
