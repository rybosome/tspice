        "op": "coords-vectors.drdpgr",
        "body": "TSPICE JACOBIAN",
        "lon": 0.7,
        "lat": -0.45,
        "alt": 1.6,
        "re": 3.0,
        "f": 0.125
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY9901001_PM",
        "values": [5, 0, 0]
      },
      {
        "op": "coords-vectors.drdpgr",
        "body": "TSPICE JACOBIAN",
        "lon": 0.7,
        "lat": -0.45,
        "alt": 1.6,
        "re": 3.0,
        "f": 0.125
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "BODY9901001_PGR_POSITIVE_LON",
        "values": ["east"]
      },
      {
        "op": "coords-vectors.drdpgr",
        "body": "TSPICE JACOBIAN",
