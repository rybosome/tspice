  },
  {
    "caseId": "coords-vectors-qderiv-balanced-extreme-endpoints",
    "description": "CSPICE scales endpoints before adding; even opposite extreme endpoints can yield a finite vector with a nonzero subnormal component.",
    "workflow": [
      {
        "op": "coords-vectors.qderiv",
        "f0": [-1.7976931348623157e308, 1.7976931348623157e308, 1],
