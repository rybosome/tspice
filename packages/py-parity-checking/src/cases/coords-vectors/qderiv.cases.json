        "delta": 1.7976931348623157e308
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "coords-vectors-qderiv-zero-delta-error",
    "description": "Zero half spacing on nonempty vectors signals a real CSPICE division error.",
    "workflow": [
      {
        "op": "coords-vectors.qderiv",
