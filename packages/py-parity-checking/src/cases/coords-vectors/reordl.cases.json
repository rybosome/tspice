[
  {
    "caseId": "coords-vectors-reordl-empty-singleton",
    "description": "Copy empty storage and a single datum without dropping trailing bytes or logical values.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [],
        "values": []
      },
      {
        "op": "coords-vectors.reordl",
        "order": [0],
        "values": [true]
      },
      {
        "op": "coords-vectors.reordl",
        "order": [0],
        "values": [false]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "coords-vectors-reordl-cycles",
    "description": "Apply a non-self-inverse source-index cycle and its inverse, distinguishing scatter from gather.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [1, 2, 3, 0],
        "values": [true, false, false, true]
      },
      {
        "op": "coords-vectors.reordl",
        "order": [3, 0, 1, 2],
        "values": [true, false, false, true]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "coords-vectors-reordl-fixed-and-disjoint",
    "description": "Reorder multiple disjoint cycles with fixed entries and every position occupied.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [0, 2, 1, 4, 3, 6, 5],
        "values": [true, false, false, true, false, true, false]
      },
      {
        "op": "coords-vectors.reordl",
        "order": [3, 2, 1, 0, 6, 5, 4],
        "values": [true, false, false, true, false, true, false]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "coords-vectors-reordl-reverse-identity",
    "description": "Keep typed payloads, extrema and duplicates intact under reversed and unchanged permutations.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [6, 5, 4, 3, 2, 1, 0],
        "values": [true, false, false, true, false, true, false]
      },
      {
        "op": "coords-vectors.reordl",
        "order": [0, 1, 2, 3, 4, 5, 6],
        "values": [true, false, false, true, false, true, false]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "coords-vectors-reordl-duplicate-order",
    "description": "An invalid permutation is rejected before an unsafe N0067 gather or cycle traversal.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [0, 0],
        "values": [true, false]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["Invalid zero-based permutation"]
    }
  },
  {
    "caseId": "coords-vectors-reordl-order-out-of-range",
    "description": "An out-of-range source index cannot address the input storage.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [-1, 1],
        "values": [true, false]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["Invalid zero-based permutation"]
    }
  },
  {
    "caseId": "coords-vectors-reordl-order-length",
    "description": "Reject a permutation with mismatched cardinality before entry.",
    "workflow": [
      {
        "op": "coords-vectors.reordl",
        "order": [0],
        "values": [true, false]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["Permutation length"]
    }
  }
]
