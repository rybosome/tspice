  {
    "caseId": "coords-vectors-m2eul-singular-angle-choices",
    "description": "Canonical singular angle choice and radians on identity, coordinate half-turn and axes permutation.",
    "workflow": [
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [1, 0, 0],
          [0, 1, 0],
          [0, 0, 1]
        ],
        "axis3": 3,
        "axis2": 1,
        "axis1": 3
      },
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [1, 0, 0],
          [0, -1, 0],
          [0, 0, -1]
        ],
        "axis3": 3,
        "axis2": 1,
        "axis1": 3
      },
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [0, -1, 0],
          [1, 0, 0],
          [0, 0, 1]
        ],
        "axis3": 3,
        "axis2": 1,
        "axis1": 3
      },
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [0, 0, 1],
          [1, 0, 0],
          [0, 1, 0]
        ],
        "axis3": 3,
        "axis2": 1,
        "axis1": 3
      },
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [1, 0, 0],
          [0, -1, 0],
          [0, 0, -1]
        ],
        "axis3": 1,
        "axis2": 2,
        "axis1": 3
      },
      {
        "op": "coords-vectors.m2eul",
        "m": [
          [0, 0, 1],
          [1, 0, 0],
          [0, 1, 0]
        ],
        "axis3": 1,
        "axis2": 2,
        "axis1": 3
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
