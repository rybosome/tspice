  {
    "caseId": "cells-windows-wnsumd-odd-cardinality",
    "description": "WNSUMD checks odd cardinality before visiting endpoint storage.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 1,
        "right": 3,
        "maxIntervals": 8
      },
      {
        "op": "cells-windows.scard",
        "targetKind": "window",
        "targetId": "W",
        "card": 1
      },
      {
        "op": "cells-windows.wnsumd",
        "windowId": "W"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDCARDINALITY"]
    }
  }
