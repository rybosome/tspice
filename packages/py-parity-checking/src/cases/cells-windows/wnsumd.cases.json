[
  {
    "caseId": "cells-windows-wnsumd-empty",
    "description": "Empty statistics and both extrema-index sentinels.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 0,
        "right": 0,
        "maxIntervals": 8
      },
      {
        "op": "cells-windows.scard",
        "targetKind": "window",
        "targetId": "W",
        "card": 0
      },
      {
        "op": "cells-windows.wnsumd",
        "windowId": "W"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-wnsumd-all-fields-and-ties",
    "description": "The first shortest and longest intervals occupy different nonzero flattened endpoint slots.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 0,
        "right": 3,
        "maxIntervals": 8
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 5,
        "right": 6
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 10,
        "right": 16
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 20,
        "right": 21
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 30,
        "right": 36
      },
      {
        "op": "cells-windows.wnsumd",
        "windowId": "W"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-wnsumd-equal-width-and-singleton",
    "description": "All widths equal, then add a zero-duration interval.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": -8,
        "right": -6,
        "maxIntervals": 8
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": -4,
        "right": -2
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 0,
        "right": 2
      },
      {
        "op": "cells-windows.wnsumd",
        "windowId": "W"
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 10,
        "right": 10
      },
      {
        "op": "cells-windows.wnsumd",
        "windowId": "W"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-wnsumd-mixed-width-population",
