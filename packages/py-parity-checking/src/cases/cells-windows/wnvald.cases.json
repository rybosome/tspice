[
  {
    "caseId": "cells-windows-wnvald-normalizes-window-success",
    "description": "wnvald validates a tracked window and preserves interval access",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W_WNVALD",
        "left": 10,
        "right": 12,
        "maxIntervals": 6
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W_WNVALD",
        "left": 2,
        "right": 4
      },
      {
        "op": "cells-windows.wnvald",
        "size": 12,
        "n": 4,
        "windowId": "W_WNVALD"
      },
      {
        "op": "cells-windows.wncard",
        "windowId": "W_WNVALD"
      },
      {
        "op": "cells-windows.wnfetd",
        "windowId": "W_WNVALD",
        "index": 0
      },
      {
        "op": "cells-windows.wnfetd",
        "windowId": "W_WNVALD",
        "index": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-wnvald-negative-n-error",
    "description": "Representative wnvald argument validation error",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W_WNVALD_ERR",
        "left": 1,
        "right": 2,
        "maxIntervals": 4
      },
      {
        "op": "cells-windows.wnvald",
        "size": 8,
        "n": -1,
        "windowId": "W_WNVALD_ERR"
      }
    ],
    "expectation": {
      "kind": "error"
    }
  },
  {
    "caseId": "cells-windows-wnvald-audit-unsorted-zero-pair",
    "description": "Growing endpoint cardinality appends zero storage; validation sorts/merges the resulting out-of-order intervals.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 2,
        "right": 4,
        "maxIntervals": 4
      },
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 7,
        "right": 8
      },
      {
        "op": "cells-windows.scard",
        "targetKind": "window",
        "targetId": "W",
        "card": 6
      },
      {
        "op": "cells-windows.wnvald",
        "windowId": "W",
        "size": 8,
        "n": 6
      },
      {
        "op": "cells-windows.wncard",
        "windowId": "W"
      },
      {
        "op": "cells-windows.wnfetd",
        "windowId": "W",
        "index": 0
      },
      {
        "op": "cells-windows.wnfetd",
        "windowId": "W",
        "index": 1
      },
      {
        "op": "cells-windows.wnfetd",
        "windowId": "W",
        "index": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-wnvald-audit-odd-endpoint-count",
    "description": "An odd input count cannot form complete intervals.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 0,
        "right": 1,
        "maxIntervals": 2
      },
      {
        "op": "cells-windows.wnvald",
        "windowId": "W",
        "size": 4,
        "n": 1
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["UNMATCHENDPTS"]
    }
  },
  {
    "caseId": "cells-windows-wnvald-audit-n-exceeds-size",
    "description": "Too many endpoints are rejected before inspecting data.",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W",
        "left": 0,
        "right": 1,
        "maxIntervals": 2
      },
      {
        "op": "cells-windows.wnvald",
        "windowId": "W",
        "size": 4,
        "n": 6
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["WINDOWTOOSMALL"]
    }
  }
]
