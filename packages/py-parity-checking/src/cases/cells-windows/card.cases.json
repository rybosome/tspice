[
  {
    "caseId": "cells-windows-card-window-cardinality-success",
    "description": "card reports endpoint cardinality for a tracked window",
    "workflow": [
      {
        "op": "cells-windows.wninsd",
        "windowId": "W_CARD",
        "left": 1,
        "right": 2,
        "maxIntervals": 4
      },
      {
        "op": "cells-windows.card",
        "targetKind": "window",
        "targetId": "W_CARD"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "cells-windows-card-missing-target-error",
    "description": "Representative card error on missing target handle",
    "workflow": [
      {
        "op": "cells-windows.card",
        "targetKind": "int",
        "targetId": "MISSING_INT"
      }
    ],
    "expectation": {
      "kind": "error"
    }
  },
  {
    "caseId": "cells-windows-card-audit-all-cell-types-and-zero",
    "description": "Cardinality is observed for int/double/char cells before and after clearing.",
    "workflow": [
      {
        "op": "cells-windows.insrti",
        "cellId": "I",
        "item": 1,
        "maxCardinality": 3
      },
      {
        "op": "cells-windows.insrtd",
        "cellId": "D",
        "item": 1.25,
        "maxCardinality": 5
      },
      {
        "op": "cells-windows.insrtc",
        "cellId": "S",
        "item": "a",
        "maxCardinality": 7,
        "length": 8
      },
      {
        "op": "cells-windows.card",
        "targetKind": "int",
        "targetId": "I"
      },
      {
        "op": "cells-windows.card",
        "targetKind": "double",
        "targetId": "D"
      },
      {
        "op": "cells-windows.card",
        "targetKind": "char",
        "targetId": "S"
      },
      {
        "op": "cells-windows.scard",
        "targetKind": "int",
        "targetId": "I",
        "card": 0
      },
      {
        "op": "cells-windows.card",
        "targetKind": "int",
        "targetId": "I"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  }
]
