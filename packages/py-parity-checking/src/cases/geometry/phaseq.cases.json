  {
    "caseId": "geometry-phaseq-translation",
    "description": "Body names and padded numeric codes reach the same native target and source identifiers.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "NAIF_BODY_NAME",
        "values": ["AUDIT TARGET"]
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "NAIF_BODY_CODE",
        "values": [100101]
      },
      {
        "op": "geometry.phaseq",
        "et": 0,
        "target": " audit target ",
        "illmn": " sun ",
        "observer": "100102",
        "abcorr": "NONE"
      },
      {
        "op": "geometry.phaseq",
        "et": 0,
        "target": " 100101 ",
        "illmn": "10",
        "observer": "100102",
        "abcorr": "NONE"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
