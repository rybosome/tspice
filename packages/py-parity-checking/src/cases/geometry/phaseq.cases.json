[
  {
    "caseId": "geometry-phaseq-epochs",
    "description": "Observe changing target-centered phase in radians across the authored moving tracks.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "geometry.phaseq",
        "et": -8000,
        "target": "100101",
        "illmn": "SUN",
        "observer": "100102",
        "abcorr": "NONE"
      },
      {
        "op": "geometry.phaseq",
        "et": -3000,
        "target": "100101",
        "illmn": "SUN",
        "observer": "100102",
        "abcorr": "NONE"
      },
      {
        "op": "geometry.phaseq",
        "et": 0,
        "target": "100101",
        "illmn": "SUN",
        "observer": "100102",
        "abcorr": "NONE"
      },
      {
        "op": "geometry.phaseq",
        "et": 3500,
        "target": "100101",
        "illmn": "SUN",
        "observer": "100102",
        "abcorr": "NONE"
      },
      {
        "op": "geometry.phaseq",
        "et": 8000,
        "target": "100101",
        "illmn": "SUN",
        "observer": "100102",
        "abcorr": "NONE"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
