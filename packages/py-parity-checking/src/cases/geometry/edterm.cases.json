[
  {
    "caseId": "geometry-edterm-geometric-epochs",
    "description": "Compare every returned field at two observation epochs with moving synthetic bodies.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "geometry.edterm",
        "target": "100101",
        "et": 11.0,
        "abcorr": "NONE",
        "observer": "100102",
        "trmtyp": "UMBRAL",
        "source": "100103",
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "npts": 6
      },
      {
        "op": "geometry.edterm",
        "target": "100101",
        "et": 327.0,
        "abcorr": "NONE",
        "observer": "100102",
        "trmtyp": "UMBRAL",
        "source": "100103",
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "npts": 6
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
