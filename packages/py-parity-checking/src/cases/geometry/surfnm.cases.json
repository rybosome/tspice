[
  {
    "caseId": "geometry-surfnm-axis-and-origin",
    "description": "Compare the three axis normals and the computed zero vector at the origin.",
    "workflow": [
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [3, 0, 0]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [0, -2, 0]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [0, 0, 1]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [0, 0, 0]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfnm-triaxial-surface",
    "description": "Different semiaxes change normal direction on a non-axis surface point.",
    "workflow": [
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [1.8, -1.6, 0]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [-1.8, 1.6, 0]
      },
      {
        "op": "geometry.surfnm",
        "a": 5,
        "b": 3,
        "c": 2,
        "point": [0, 1.8, -1.6]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfnm-level-set-direction",
    "description": "Check normalized directions for positive rescalings of the same level-set point.",
    "workflow": [
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [1, -2, 3]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [10, -20, 30]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 2,
        "c": 1,
        "point": [-1, 2, -3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfnm-sphere",
    "description": "On a spherical surface the outward normal follows the unit radius.",
    "workflow": [
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 3,
        "c": 3,
        "point": [1, 2, -2]
      },
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": 3,
        "c": 3,
        "point": [-1, -2, 2]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfnm-nonpositive-axes",
    "description": "Preserve the actual surface normal error for invalid axis lengths.",
    "workflow": [
      {
        "op": "geometry.surfnm",
        "a": 3,
        "b": -2,
        "c": 0,
        "point": [1, 2, 3]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["BADAXISLENGTH"]
    }
  }
]
