  {
    "caseId": "geometry-lspcn-pole-and-meridian",
    "description": "Change the prime-meridian angle and spin, then rotate the pole. Only the pole orientation changes the season frame.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-seasonal-pole.tpc"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 0,
        "abcorr": "NONE"
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY100101_PM",
        "values": [111, -675, 0]
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 0,
        "abcorr": "NONE"
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY100101_POLE_RA",
        "values": [170, 0, 0]
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY100101_POLE_DEC",
        "values": [-30, 0, 0]
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 0,
        "abcorr": "NONE"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 3500,
        "abcorr": "NONE"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
