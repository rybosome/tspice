[
  {
    "caseId": "geometry-lspcn-equinox-and-epochs",
    "description": "Project the Sun into the orbital plane using the tilted authored north pole at five epochs.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-seasonal-pole.tpc"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": -8000,
        "abcorr": "NONE"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": -3000,
        "abcorr": "NONE"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 0,
        "abcorr": "NONE"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 3500,
        "abcorr": "NONE"
      },
      {
        "op": "geometry.lspcn",
        "body": "100101",
        "et": 8000,
        "abcorr": "NONE"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
