[
  {
    "caseId": "geometry-nvp2pl-axis-sign",
    "description": "Nonunit normal, signed side of origin and closest point conventions.",
    "workflow": [
      {
        "op": "geometry.nvp2pl",
        "normal": [2, 0, 0],
        "point": [-5, 4, 9]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [-2, 0, 0],
        "point": [5, 4, 9]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [0, -4, 0],
        "point": [1, 0, 1]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-nvp2pl-through-origin",
    "description": "Canonical constant zero including oblique and signed normals.",
    "workflow": [
      {
        "op": "geometry.nvp2pl",
        "normal": [0.6, 0.8, 0],
        "point": [0, 0, 0]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [0, -9, 0],
        "point": [0, 0, 0]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [2, -3, 7],
        "point": [0, 0, 0]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-nvp2pl-scale",
    "description": "A plane point with equivalent positive and negative normal scalings.",
    "workflow": [
      {
        "op": "geometry.nvp2pl",
        "normal": [3, 4, 0],
        "point": [2, -3, 7]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [0.75, 1, 0],
        "point": [2, -3, 7]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [-6, -8, 0],
        "point": [2, -3, 7]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-nvp2pl-varied-point",
    "description": "Mixed axes and same plane traced by distinct points.",
    "workflow": [
      {
        "op": "geometry.nvp2pl",
        "normal": [1, 2, 3],
        "point": [2, -3, 7]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [1, 2, 3],
        "point": [4, -4, 7]
      },
      {
        "op": "geometry.nvp2pl",
        "normal": [1, 2, 3],
        "point": [-1, -2, -3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-nvp2pl-zero-normal",
    "description": "Actual CSPICE rejects zero normal.",
    "workflow": [
      {
        "op": "geometry.nvp2pl",
        "normal": [0, 0, 0],
        "point": [2, -3, 7]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["ZEROVECTOR"]
    }
  }
]
