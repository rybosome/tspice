[
  {
    "caseId": "geometry-inelpl-two-points",
    "description": "Secant cuts through and away from the center, with signed orientation.",
    "workflow": [
      {
        "op": "geometry.inelpl",
        "ellipse": {
          "center": [0, 0, 0],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [1, 0, 0, 0]
      },
      {
        "op": "geometry.inelpl",
        "ellipse": {
          "center": [0, 0, 0],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [1, 0, 0, 1]
      },
      {
        "op": "geometry.inelpl",
        "ellipse": {
          "center": [0, 0, 0],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [0, -1, 0, 1]
      },
      {
        "op": "geometry.inelpl",
        "ellipse": {
          "center": [2, -3, 5],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [1, 0, 0, 4]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
