        "plane": [0, 0, 1, 0]
      },
      {
        "op": "geometry.pjelpl",
        "ellipse": {
          "center": [2, -3, 5],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [0, 0, 1, 5]
      },
      {
        "op": "geometry.pjelpl",
        "ellipse": {
          "center": [2, -3, 5],
          "semiMajor": [3, 0, 0],
          "semiMinor": [0, 2, 0]
        },
        "plane": [0, 0, -1, 4]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
