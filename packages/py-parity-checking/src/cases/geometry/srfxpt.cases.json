[
  {
    "caseId": "geometry-srfxpt-geometric-epochs",
    "description": "Compare every returned field at two observation epochs with moving synthetic bodies.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-legacy-frame.tf"
      },
      {
        "op": "geometry.srfxpt",
        "target": "100101",
        "et": 11.0,
        "abcorr": "NONE",
        "observer": "100102",
        "method": "ELLIPSOID",
        "dref": "J2000",
        "dvec": [-10.0, -4.0, -3.0]
      },
      {
        "op": "geometry.srfxpt",
        "target": "100101",
        "et": 327.0,
        "abcorr": "NONE",
        "observer": "100102",
        "method": "ELLIPSOID",
        "dref": "J2000",
        "dvec": [-10.0, -4.0, -3.0]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
