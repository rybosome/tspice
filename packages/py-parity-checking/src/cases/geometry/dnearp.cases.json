        "op": "geometry.dnearp",
        "state": [4, 2, 1, 0, 0, 0],
        "a": 3,
        "b": 2,
        "c": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-dnearp-scale",
