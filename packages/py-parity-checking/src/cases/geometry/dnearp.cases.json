[
  {
    "caseId": "geometry-dnearp-triaxial",
    "description": "Observe all nearest-point and derivative components for moving states in distinct octants.",
    "workflow": [
      {
        "op": "geometry.dnearp",
        "state": [4, 2, 1, 1, -2, 3],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.dnearp",
        "state": [-6, 1, 3, -0.5, 4, 2],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.dnearp",
        "state": [3, 4, -8, 4, -3, 8],
        "a": 1,
        "b": 4,
        "c": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-dnearp-sphere",
    "description": "The closest point follows radial projection: radial motion changes altitude, tangential motion changes the surface point.",
    "workflow": [
      {
        "op": "geometry.dnearp",
        "state": [3, 4, 0, 0, 0, 0],
        "a": 2,
        "b": 2,
        "c": 2
      },
      {
        "op": "geometry.dnearp",
        "state": [3, 4, 0, 3, 4, 0],
        "a": 2,
        "b": 2,
        "c": 2
      },
      {
        "op": "geometry.dnearp",
        "state": [3, 4, 0, -4, 3, 0],
        "a": 2,
        "b": 2,
        "c": 2
      },
      {
        "op": "geometry.dnearp",
        "state": [3, 4, 0, 1, -3, 4],
        "a": 2,
        "b": 2,
        "c": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-dnearp-focal-set",
