        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.dnearp",
        "state": [128, -64, 32, 32, -64, 96],
        "a": 96,
        "b": 64,
        "c": 32
      }
    ],
    "expectation": {
      "kind": "success"
    }
