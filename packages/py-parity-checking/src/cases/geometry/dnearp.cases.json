    "workflow": [
      {
        "op": "geometry.dnearp",
        "state": [4, 2, 1, 1, -2, 3],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.dnearp",
        "state": [4, 2, 1, -2, 4, -6],
        "a": 3,
        "b": 2,
        "c": 1
      },
