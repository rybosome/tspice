  {
    "caseId": "geometry-fovray-shape-audit_circle",
    "description": "Compare inside, outside and near-edge rays using this instrument shape.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-fov.ti"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "geometry.fovray",
        "inst": "AUDIT_CIRCLE",
        "raydir": [2, 0, 0],
        "rframe": "J2000",
        "abcorr": "NONE",
        "observer": "100103",
        "et": 0
      },
      {
        "op": "geometry.fovray",
        "inst": "AUDIT_CIRCLE",
        "raydir": [1, 0.2499, 0],
        "rframe": "J2000",
        "abcorr": "NONE",
        "observer": "100103",
        "et": 0
      },
      {
        "op": "geometry.fovray",
        "inst": "AUDIT_CIRCLE",
        "raydir": [1, 0.2501, 0],
        "rframe": "J2000",
        "abcorr": "NONE",
        "observer": "100103",
        "et": 0
      },
      {
        "op": "geometry.fovray",
        "inst": "AUDIT_CIRCLE",
        "raydir": [-1, 0, 0],
        "rframe": "J2000",
        "abcorr": "NONE",
        "observer": "100103",
        "et": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
