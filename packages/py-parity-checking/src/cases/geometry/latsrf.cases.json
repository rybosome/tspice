[
  {
    "caseId": "geometry-latsrf-ellipsoid",
    "description": "Check signed axes, hemisphere ordering and triaxial coordinates on the authored ellipsoid.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "geometry.latsrf",
        "method": "ELLIPSOID",
        "target": "100101",
        "et": 0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "lonlat": [
          [0.31, 0.21],
          [-0.71, 0.15],
          [2.13, -0.49]
        ]
      },
      {
        "op": "geometry.latsrf",
        "method": "ELLIPSOID",
        "target": "100101",
        "et": 0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "lonlat": [
          [0, 0],
          [1.5707963267948966, 0],
          [0, -1.5707963267948966],
          [0.5, 2.4]
        ]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
