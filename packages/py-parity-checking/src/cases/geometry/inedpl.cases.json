[
  {
    "caseId": "geometry-inedpl-central-sections",
    "description": "Three principal planes through a distinct triaxial body.",
    "workflow": [
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [1, 0, 0, 0]
      },
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [0, 1, 0, 0]
      },
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [0, 0, 1, 0]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-inedpl-parallel-sections",
    "description": "Off-center cuts and tangencies with both normal signs.",
    "workflow": [
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [0, 0, 1, 0.5]
      },
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [0, 0, -1, 0.75]
      },
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [0, 0, 1, 1]
      },
      {
        "op": "geometry.inedpl",
        "a": 3,
        "b": 2,
        "c": 1,
        "plane": [1, 0, 0, 3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-inedpl-miss",
