        "c": 1,
        "plane": [0, 1, 0, 4]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-inedpl-oblique",
    "description": "Oblique section of a triaxial body with distinguishable ellipse axes.",
    "workflow": [
      {
        "op": "geometry.inedpl",
        "a": 4,
        "b": 2,
        "c": 1,
        "plane": [0.6, 0, 0.8, 0.25]
