      {
        "op": "geometry.inedpl",
        "a": 5,
        "b": 3,
        "c": 2,
        "plane": [0, -0.8, 0.6, 1.25]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-inedpl-spherical-section",
