      {
        "op": "geometry.psv2pl",
        "point": [2, -3, 7],
        "span1": [1, 0, 0],
        "span2": [0, 0, 0]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["DEGENERATECASE"]
    }
  },
  {
    "caseId": "geometry-psv2pl-parallel",
    "description": "Dependent spanning vectors must signal the actual toolkit condition.",
    "workflow": [
      {
        "op": "geometry.psv2pl",
        "point": [2, -3, 7],
        "span1": [1, 0, 0],
        "span2": [-3, 0, 0]
