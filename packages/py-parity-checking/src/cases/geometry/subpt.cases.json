[
  {
    "caseId": "geometry-subpt-geometric-epochs",
    "description": "Compare every returned field at two observation epochs with moving synthetic bodies.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-legacy-frame.tf"
      },
      {
        "op": "geometry.subpt",
        "target": "100101",
        "et": 11.0,
        "abcorr": "NONE",
        "observer": "100102",
        "method": "Near point"
      },
      {
        "op": "geometry.subpt",
        "target": "100101",
        "et": 327.0,
        "abcorr": "NONE",
        "observer": "100102",
        "method": "Near point"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
