[
  {
    "caseId": "geometry-surfpv-moving-ray",
    "description": "Use independently moving vertex and direction; inspect the complete intercept state.",
    "workflow": [
      {
        "op": "geometry.surfpv",
        "vertex": [5, 1, 0.1, 0.5, -2, 3],
        "direction": [-2, -0.2, 0, 0.02, 0.01, 0.1],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.surfpv",
        "vertex": [5, 1, 0.1, 0.5, -2, 3],
        "direction": [-2, -0.2, 0, 0, 0, 0],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.surfpv",
        "vertex": [5, 1, 0.1, 0, 0, 0],
        "direction": [-2, -0.2, 0, 0.02, 0.01, 0.1],
        "a": 3,
        "b": 2,
        "c": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfpv-front-back",
    "description": "Distinguish a forward hit from a backward-only intersection, a perpendicular miss and an inside-to-outside hit.",
    "workflow": [
      {
        "op": "geometry.surfpv",
        "vertex": [4, 0, 0, 1, 2, 3],
        "direction": [-1, 0, 0, 0, 0, 0],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.surfpv",
        "vertex": [4, 0, 0, 1, 2, 3],
        "direction": [1, 0, 0, 0, 0, 0],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.surfpv",
        "vertex": [4, 0, 0, 1, 2, 3],
        "direction": [0, 1, 0, 0, 0, 0],
        "a": 3,
        "b": 2,
        "c": 1
      },
      {
        "op": "geometry.surfpv",
        "vertex": [0, 0, 0, 0, 1, 0],
        "direction": [1, 0, 0, 0, 0, 0.1],
        "a": 3,
        "b": 2,
        "c": 1
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "geometry-surfpv-exact-tangent",
    "description": "A tangent sphere hit can have undefined velocity. Observe absence and the different results for rays just inside and outside.",
    "workflow": [
      {
        "op": "geometry.surfpv",
        "vertex": [1.999, -4, 0, 0, 0.2, 0],
        "direction": [0, 1, 0, 0, 0, 0.1],
        "a": 2,
        "b": 2,
        "c": 2
      },
      {
        "op": "geometry.surfpv",
        "vertex": [2, -4, 0, 0, 0.2, 0],
        "direction": [0, 1, 0, 0, 0, 0.1],
        "a": 2,
        "b": 2,
        "c": 2
      },
      {
        "op": "geometry.surfpv",
        "vertex": [2.001, -4, 0, 0, 0.2, 0],
        "direction": [0, 1, 0, 0, 0, 0.1],
        "a": 2,
        "b": 2,
        "c": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
