[
  {
    "caseId": "geometry-srfnrm-ellipsoid",
    "description": "Check signed axes, hemisphere ordering and triaxial coordinates on the authored ellipsoid.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "geometry.srfnrm",
        "method": "ELLIPSOID",
        "target": "100101",
        "et": 0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "srfpts": [
          [3, 0, 0],
          [0, -2, 0],
          [0, 0, 1]
        ]
      },
      {
        "op": "geometry.srfnrm",
        "method": "ELLIPSOID",
        "target": "100101",
        "et": 0,
        "fixref": "AUDIT_GEOMETRY_FIXED",
        "srfpts": [[2.313384955073964, 0.7410408309436486, 0.5177603097428078]]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
