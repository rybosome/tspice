  {
    "caseId": "frames-tisbod-earth-epochs",
    "description": "Compare every row-major component for a rotating Earth at negative, zero and positive ET.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/pck00010.tpc"
      },
      {
        "op": "frames.tisbod",
        "ref": "J2000",
        "body": 399,
        "et": -86401.5
      },
      {
        "op": "frames.tisbod",
        "ref": "J2000",
        "body": 399,
        "et": 0
      },
      {
        "op": "frames.tisbod",
        "ref": "J2000",
        "body": 399,
        "et": 123456.25
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
