[
  {
    "caseId": "frames-pckuof-priority",
    "description": "At a shared epoch the latest file wins. Reloading the original promotes it, then one unload exposes the authored lower-priority orientation.",
    "workflow": [
      {
        "op": "frames.pckopn",
        "handleId": "w",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "ifname": "TSPICE TEST",
        "ncomch": 0
      },
      {
        "op": "frames.pckw02",
        "handleId": "w",
        "classId": 3000,
        "frame": "J2000",
        "first": 0,
        "last": 20,
        "segid": "TWO RECORDS",
        "intlen": 10,
        "n": 2,
        "degree": 1,
        "coefficients": [
          0.2, 0.03, 0.5, -0.02, 0.7, 0.04, 0.4, -0.01, 0.8, 0.01, 1.1, -0.06
        ],
        "btime": 0
      },
      {
        "op": "frames.pckcls",
        "handleId": "w"
      },
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "a"
      },
      {
        "op": "frames.pcklof",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "handleId": "b"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 14
      },
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "again"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 14
      },
      {
        "op": "frames.pckuof",
        "handleId": "again"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 14
      },
      {
        "op": "frames.pckuof",
        "handleId": "b"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-pckuof-last-unload",
    "description": "Unloading the only directly loaded PCK removes its frame data.",
    "workflow": [
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "p"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": -6
      },
      {
        "op": "frames.pckuof",
        "handleId": "p"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": -6
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["FRAMEDATANOTFOUND"]
    }
  },
  {
    "caseId": "frames-pckuof-reload",
    "description": "A fresh load after unloading restores complete orientation and derivative.",
    "workflow": [
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "p"
      },
      {
        "op": "frames.pckuof",
        "handleId": "p"
      },
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "p"
      },
      {
        "op": "frames.sxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 12
      },
      {
        "op": "frames.pckuof",
        "handleId": "p"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-pckuof-keeper",
    "description": "Direct binary PCK loading and unloading do not add entries to KEEPER.",
    "workflow": [
      {
        "op": "frames.pcklof",
        "path": "kernels/audit-orientation.bpc",
        "handleId": "p"
      },
      {
        "op": "kernels.ktotal",
        "kind": "ALL"
      },
      {
        "op": "frames.pckuof",
        "handleId": "p"
      },
      {
        "op": "kernels.ktotal",
        "kind": "ALL"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  }
]
