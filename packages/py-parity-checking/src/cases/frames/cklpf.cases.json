  {
    "caseId": "frames-cklpf-open-query-close-success",
    "description": "cklpf opens CK for subsequent query and closes via ckupf",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/mgs_sclkscet_00061.tsc"
      },
      {
        "op": "frames.cklpf",
        "ck": "kernels/mgs_hga_hinge_v2.bc",
        "handleId": "CKH_CKLPF"
      },
      {
        "op": "frames.ckobj",
        "ck": "kernels/mgs_hga_hinge_v2.bc",
        "idsId": "IDS_CKLPF",
        "maxCard": 32
      },
      {
        "op": "frames.ckupf",
        "handleId": "CKH_CKLPF"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
