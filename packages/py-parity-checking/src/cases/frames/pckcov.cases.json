    "caseId": "frames-pckcov-accumulate",
    "description": "Append coverage to a nonempty window, including bridges, overlap and deduplication.",
    "workflow": [
      {
        "op": "frames.pckopn",
        "handleId": "w",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "ifname": "TSPICE TEST",
        "ncomch": 0
      },
      {
        "op": "frames.pckw02",
        "handleId": "w",
        "classId": 3000,
        "frame": "J2000",
        "first": 0,
        "last": 20,
        "segid": "TWO RECORDS",
        "intlen": 10,
        "n": 2,
        "degree": 1,
        "coefficients": [
          0.2, 0.03, 0.5, -0.02, 0.7, 0.04, 0.4, -0.01, 0.8, 0.01, 1.1, -0.06
        ],
        "btime": 0
      },
      {
        "op": "frames.pckcls",
        "handleId": "w"
      },
      {
        "op": "frames.pckcov",
        "path": "kernels/audit-orientation.bpc",
        "classId": 3000,
        "coverId": "cov",
        "maxIntervals": 6,
        "reset": true
      },
