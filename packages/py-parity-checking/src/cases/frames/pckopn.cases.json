[
  {
    "caseId": "frames-pckopn-roundtrip",
    "description": "Open a new PCK, write two angular records, close and reopen for independent frame, coverage and matrix observations.",
    "workflow": [
      {
        "op": "frames.pckopn",
        "handleId": "w",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "ifname": "TSPICE TEST",
        "ncomch": 0
      },
      {
        "op": "frames.pckw02",
        "handleId": "w",
        "classId": 3000,
        "frame": "J2000",
        "first": 0,
        "last": 20,
        "segid": "TWO RECORDS",
        "intlen": 10,
        "n": 2,
        "degree": 1,
        "coefficients": [
          0.2, 0.03, 0.5, -0.02, 0.7, 0.04, 0.4, -0.01, 0.8, 0.01, 1.1, -0.06
        ],
        "btime": 0
      },
      {
        "op": "frames.pckcls",
        "handleId": "w"
      },
      {
        "op": "frames.pckfrm",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "idsId": "ids",
        "maxCard": 8,
        "reset": true
      },
      {
        "op": "frames.pckcov",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "classId": 3000,
        "coverId": "cov",
        "maxIntervals": 6,
        "reset": true
      },
      {
        "op": "frames.pcklof",
        "path": {
          "kind": "scratch",
          "rel": "output.bpc"
        },
        "handleId": "p"
      },
      {
        "op": "frames.pxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 2
      },
      {
        "op": "frames.sxform",
        "from": "J2000",
        "to": "ITRF93",
        "et": 14
      },
      {
        "op": "frames.pckuof",
        "handleId": "p"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
