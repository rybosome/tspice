  {
    "caseId": "frames-cnmfrm-audit-authored-preference-lifecycle",
    "description": "Authored NAIF body-name mapping and preferred frame load/unload produce real not-found/found/not-found states.",
    "workflow": [
      {
        "op": "frames.cnmfrm",
        "centerName": "AUDIT_WORLD"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-frames.tf"
      },
      {
        "op": "frames.cnmfrm",
        "centerName": "audit_world"
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-frames.tf"
      },
      {
        "op": "frames.cnmfrm",
        "centerName": "AUDIT_WORLD"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
