  {
    "caseId": "frames-tkfram-unloaded",
    "description": "Unloading this FK expires both class metadata and cached fixed rotations.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-geometry.tf"
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      }
    ],
    "expectation": {
      "kind": "error",
