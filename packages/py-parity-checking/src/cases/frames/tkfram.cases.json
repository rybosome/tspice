      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-tkfram-angles-and-matrix",
    "description": "Check both matrix and angle specifications with asymmetric rotation and base ID.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800201
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-tkfram-reload",
    "description": "The same fixed frame responds to a live kernel angle change.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "TKFRAME_1800202_ANGLES",
        "values": [22, -15, 73]
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-tkfram-zero",
    "description": "Zero is an invalid frame class ID.",
    "workflow": [
      {
        "op": "frames.tkfram",
        "typeId": 0
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["ZEROFRAMEID"]
    }
  },
  {
    "caseId": "frames-tkfram-unknown",
