  {
    "caseId": "frames-tkfram-invalid-relative",
    "description": "An unknown base frame triggers a toolkit diagnostic.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "TKFRAME_1800202_RELATIVE",
        "values": ["NO_SUCH_FRAME"]
      },
      {
        "op": "frames.tkfram",
        "typeId": 1800202
      }
