  {
    "caseId": "frames-xfmsta-longitude-override",
    "description": "Explicit east-positive Mars longitude changes planetographic coordinates and angular rates.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/pck00010.tpc"
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "PLANETOGRAPHIC",
        "body": "MARS",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "BODY499_PGR_POSITIVE_LON",
        "values": ["EAST"]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "PLANETOGRAPHIC",
        "body": "499",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      }
    ],
    "expectation": {
      "kind": "success"
    }
