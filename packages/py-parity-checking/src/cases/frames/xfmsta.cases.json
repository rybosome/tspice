  {
    "caseId": "frames-xfmsta-same-system",
    "description": "Identical systems copy before resolving radii or checking singularities.",
    "workflow": [
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "RECTANGULAR",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      },
      {
        "op": "frames.xfmsta",
        "from": "CYLINDRICAL",
        "to": "CYLINDRICAL",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      },
      {
        "op": "frames.xfmsta",
        "from": "LATITUDINAL",
        "to": "LATITUDINAL",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      },
      {
        "op": "frames.xfmsta",
        "from": "SPHERICAL",
        "to": "SPHERICAL",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      },
      {
        "op": "frames.xfmsta",
        "from": "GEODETIC",
        "to": "GEODETIC",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      },
      {
        "op": "frames.xfmsta",
        "from": "PLANETOGRAPHIC",
        "to": "PLANETOGRAPHIC",
        "body": "NO_SUCH_BODY",
        "state": [-3, 4, 5, 6, 7, 8]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-xfmsta-axis",
    "description": "A purely axial velocity has directly specified rates even at a pole or origin.",
    "workflow": [
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "CYLINDRICAL",
        "body": " ",
        "state": [0, 0, -2, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "LATITUDINAL",
        "body": " ",
        "state": [0, 0, -2, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "SPHERICAL",
        "body": " ",
        "state": [0, 0, -2, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "CYLINDRICAL",
        "body": " ",
        "state": [0, 0, 0, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "LATITUDINAL",
        "body": " ",
        "state": [0, 0, 0, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "SPHERICAL",
        "body": " ",
        "state": [0, 0, 0, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "CYLINDRICAL",
        "body": " ",
        "state": [0, 0, 2, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "LATITUDINAL",
        "body": " ",
        "state": [0, 0, 2, 0, 0, -3]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "SPHERICAL",
        "body": " ",
        "state": [0, 0, 2, 0, 0, -3]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "frames-xfmsta-transverse",
    "description": "A nonzero transverse velocity at a pole makes the coordinate derivative undefined.",
    "workflow": [
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "LATITUDINAL",
        "body": " ",
        "state": [0, 0, 4, 1, 0, 2]
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["INVALIDSTATE"]
    }
  },
  {
    "caseId": "frames-xfmsta-bad-system",
