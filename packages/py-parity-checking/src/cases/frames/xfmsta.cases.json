[
  {
    "caseId": "frames-xfmsta-rectangular-to-all",
    "description": "Compare each coordinate, ordering and derivative for every destination.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/pck00010.tpc"
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "CYLINDRICAL",
        "body": "EARTH",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "LATITUDINAL",
        "body": "EARTH",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "SPHERICAL",
        "body": "EARTH",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "GEODETIC",
        "body": "EARTH",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      },
      {
        "op": "frames.xfmsta",
        "from": "RECTANGULAR",
        "to": "PLANETOGRAPHIC",
        "body": "EARTH",
        "state": [5700.0, -3900.0, 1800.0, -3.2, 4.6, 0.75]
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
