  {
    "caseId": "ek-eknelt-psel-preserves-results",
    "description": "Parsing a different SELECT leaves the current EKFIND result available.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT CV,DF,DV FROM AUDIT_QUERY ORDER BY KEY"
      },
      {
        "op": "ek.eknelt",
        "selidx": 0,
        "row": 2
      },
      {
        "op": "ek.ekpsel",
        "query": "SELECT KEY,CV, DV FROM AUDIT_QUERY"
      },
      {
        "op": "ek.eknelt",
        "selidx": 0,
        "row": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
