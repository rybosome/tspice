  {
    "caseId": "ek-eknelt-replacement-query",
    "description": "A new SELECT changes item order and row order. Observe size from both result sets.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "ek.ekfind",
