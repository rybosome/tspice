      },
      {
        "op": "ek.eknelt",
        "selidx": 0,
        "row": 2
      },
      {
        "op": "ek.eknelt",
        "selidx": 1,
        "row": 0
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT IFIX,CV FROM AUDIT_QUERY ORDER BY KEY DESC"
