[
  {
    "caseId": "ek-ekifld-happy-segment-initialization-observable",
    "description": "ekifld initializes a fast-write segment that can be finalized and counted",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": ".py-parity-ek-ekifld-happy.ek",
        "ifname": "ekifld-happy",
        "ncomch": 0,
        "handleId": "H_IFLD"
      },
      {
        "op": "ek.ekifld",
        "handleId": "H_IFLD",
        "tabnam": "IFLD_TABLE",
        "nrows": 2,
        "cnames": ["ID"],
        "decls": ["DATATYPE = INTEGER"],
        "segmentId": "SEG_IFLD"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "SEG_IFLD",
        "column": "ID",
        "ivals": [101, 202],
        "entszs": [1, 1],
        "nlflgs": [false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "SEG_IFLD"
      },
      {
        "op": "ek.eknseg",
        "handleId": "H_IFLD"
      },
      {
        "op": "ek.ekcls",
        "handleId": "H_IFLD"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-ekifld-invalid-nrows-error",
    "description": "ekifld errors when nrows is outside the allowed range",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": ".py-parity-ek-ekifld-error.ek",
        "ifname": "ekifld-error",
        "ncomch": 0,
        "handleId": "H_IFLD_ERR"
      },
      {
        "op": "ek.ekifld",
        "handleId": "H_IFLD_ERR",
        "tabnam": "BAD_TABLE",
        "nrows": 0,
        "cnames": ["ID"],
        "decls": ["DATATYPE = INTEGER"],
        "segmentId": "SEG_BAD"
      }
    ],
    "expectation": {
      "kind": "error"
    }
  },
  {
    "caseId": "ek-ekifld-audit-full-workspace-and-data",
    "description": "All returned segno/rcptrs entries are compared, retained unchanged for column writing/finalization, then consumed through actual finalized data and segment count. Lowercase table/default scalar declaration exercise CSPICE defaults.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "w",
        "path": {
          "kind": "scratch",
          "rel": "workspace.ek"
        },
        "ifname": "AUTHORED_LIFECYCLE",
        "ncomch": 0
      },
      {
        "op": "ek.ekifld",
        "handleId": "w",
        "tabnam": "audit_mixed",
        "nrows": 3,
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"],
        "segmentId": "first"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "first",
        "column": "ID",
        "ivals": [-7, 11, 99],
        "entszs": [1, 1, 1],
        "nlflgs": [false, false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "first"
      },
      {
        "op": "ek.ekcls",
        "handleId": "w"
      },
      {
        "op": "ek.ekopr",
        "handleId": "r",
        "path": {
          "kind": "scratch",
          "rel": "workspace.ek"
        }
      },
      {
        "op": "ek.eknseg",
        "handleId": "r"
      },
      {
        "op": "ek.ekcls",
        "handleId": "r"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-ekifld-audit-second-segment-number",
    "description": "Two sequential completed fast writes return distinct zero-based segment numbers and full record pointer arrays; no query or other EK operation interrupts a fast write.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "w",
        "path": {
          "kind": "scratch",
          "rel": "two-pointers.ek"
        },
        "ifname": "AUTHORED_LIFECYCLE",
        "ncomch": 0
      },
      {
        "op": "ek.ekifld",
        "handleId": "w",
        "tabnam": "AUDIT_SHARED",
        "nrows": 2,
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"],
        "segmentId": "s0"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "s0",
        "column": "ID",
        "ivals": [-7, 11],
        "entszs": [1, 1],
        "nlflgs": [false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "s0"
      },
      {
        "op": "ek.ekcls",
        "handleId": "w"
      },
      {
        "op": "ek.ekopw",
        "handleId": "append",
        "path": {
          "kind": "scratch",
          "rel": "two-pointers.ek"
        }
      },
      {
        "op": "ek.ekifld",
        "handleId": "append",
        "tabnam": "AUDIT_SHARED",
        "nrows": 1,
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"],
        "segmentId": "s1"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "s1",
        "column": "ID",
        "ivals": [99],
        "entszs": [1],
        "nlflgs": [false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "s1"
      },
      {
        "op": "ek.ekcls",
        "handleId": "append"
      },
      {
        "op": "ek.ekopr",
        "handleId": "read",
        "path": {
          "kind": "scratch",
          "rel": "two-pointers.ek"
        }
      },
      {
        "op": "ek.eknseg",
        "handleId": "read"
      },
      {
        "op": "ek.ekcls",
        "handleId": "read"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-ekifld-audit-long-table",
