[
  {
    "caseId": "ek-eklef-direct-only",
    "description": "The direct query load registers the physical file independently from KEEPER and survives KCLEAR.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-query.ek"
      },
      {
        "op": "ek.eklef",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-query.ek"
        },
        "handleId": "h"
      },
      {
        "op": "ek.ekntab"
      },
      {
        "op": "kernels.ktotal",
        "kind": "EK"
      },
      {
        "op": "ek.ekccnt",
        "table": "AUDIT_QUERY"
      },
      {
        "op": "kernels.kclear"
      },
      {
        "op": "ek.ekccnt",
        "table": "AUDIT_QUERY"
      },
      {
        "op": "ek.ekssum",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekuef",
        "handleId": "h"
      },
      {
        "op": "ek.ekntab"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
