  {
    "caseId": "ek-eklef-keeper-overlap",
    "description": "One physical EK can be furnished and directly loaded. Unloading its KEEPER registration removes its query tables.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "ek.eklef",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-query.ek"
        },
        "handleId": "h"
      },
      {
        "op": "ek.ekntab"
      },
      {
        "op": "kernels.unload",
        "path": "kernels/audit-query.ek"
      },
      {
        "op": "ek.ekntab"
      },
      {
        "op": "ek.ekuef",
        "handleId": "h"
      },
      {
        "op": "ek.ekntab"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-eklef-empty-ek",
    "description": "The actual query loader rejects an independently created EK with zero segments.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": "empty-c10.ek",
        "ifname": "Empty EK",
        "ncomch": 0,
        "handleId": "r"
      },
      {
        "op": "ek.ekcls",
        "handleId": "r"
      },
      {
        "op": "ek.eklef",
        "path": "empty-c10.ek",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["SPICE(EKNOSEGMENTS)"]
    }
  },
  {
    "caseId": "ek-eklef-missing-file",
    "description": "A missing EK file signals a real file-open error.",
    "workflow": [
      {
        "op": "ek.eklef",
        "path": "absent-c10.ek",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["SPICE(FILENOTFOUND)"]
    }
  }
