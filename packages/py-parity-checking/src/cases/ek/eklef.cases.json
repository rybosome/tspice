        },
        "handleId": "h"
      },
      {
        "op": "ek.eklef",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-query.ek"
        },
        "handleId": "dup"
      },
      {
        "op": "ek.ekntab"
