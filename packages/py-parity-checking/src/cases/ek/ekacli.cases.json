      {
        "op": "ek.ekifld",
        "handleId": "w",
        "tabnam": "AUDIT_WRITE",
        "nrows": 3,
        "cnames": ["KEY", "DATA"],
        "decls": [
          "DATATYPE=INTEGER,INDEXED=TRUE",
          "DATATYPE=INTEGER,SIZE=2,NULLS_OK=TRUE"
        ],
        "segmentId": "s"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "s",
        "column": "KEY",
