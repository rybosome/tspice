  {
    "caseId": "ek-ekfind-audit-zero-rows-and-replacement",
    "description": "Distinguish successful zero rows from errors, then replace selection and observe exact first/last descending keys30/10.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT KEY FROM AUDIT_QUERY WHERE KEY < 0"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT KEY FROM AUDIT_QUERY ORDER BY KEY DESC"
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 2,
        "elment": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
