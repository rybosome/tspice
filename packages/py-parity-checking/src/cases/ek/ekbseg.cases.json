[
  {
    "caseId": "ek-ekbseg-schema",
    "description": "Build distinct scalar integer, time, double and variable character descriptors. Compare segment ordinal, count and record edits.",
    "workflow": [
      {
        "op": "ek.ekops",
        "handleId": "h"
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "MIXED",
        "cnames": ["KEY", "TIME", "X", "TEXT"],
        "decls": [
          "DATATYPE=INTEGER, INDEXED=TRUE",
          "DATATYPE=TIME",
          "DATATYPE=DOUBLE PRECISION,SIZE=2",
          "DATATYPE=CHARACTER*(16),SIZE=VARIABLE,NULLS_OK=TRUE"
        ]
      },
      {
        "op": "ek.eknseg",
        "handleId": "h"
      },
      {
        "op": "ek.ekappr",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekdelr",
        "handleId": "h",
        "segno": 0,
        "recno": 0
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-ekbseg-multiple",
    "description": "Repeated logical table names occupy separate physical segments. Named file close/reopen preserves all three.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c08.ek"
        },
        "ifname": "ORDERS",
        "ncomch": 0
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "LOW",
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"]
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "HIGH",
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"]
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "LOW",
        "cnames": ["ID"],
        "decls": ["DATATYPE=INTEGER"]
      },
      {
        "op": "ek.eknseg",
        "handleId": "h"
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      },
      {
        "op": "ek.ekopr",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c08.ek"
        }
      },
      {
        "op": "ek.eknseg",
        "handleId": "h"
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
