  {
    "caseId": "ek-ekbseg-fixed-schema",
    "description": "All-fixed scalar declarations create a separate supported segment type. Inspect its count without individual edits.",
    "workflow": [
      {
        "op": "ek.ekops",
        "handleId": "h"
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "FIXED",
        "cnames": ["I", "D"],
        "decls": [
          "DATATYPE=INTEGER,FIXED_COUNT=TRUE",
          "DATATYPE=DOUBLE PRECISION,FIXED_COUNT=TRUE"
        ]
      },
      {
        "op": "ek.eknseg",
        "handleId": "h"
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
