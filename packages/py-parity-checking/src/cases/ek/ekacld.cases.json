        "nlflgs": [false, false, false]
      },
      {
        "op": "ek.ekacld",
        "segmentId": "s",
        "column": "DATA",
        "dvals": [-7.25, 8.5, 0, 0, 77.75, -99.125],
        "entszs": [2, 2, 2],
        "nlflgs": [false, true, false]
      },
      {
        "op": "ek.ekffld",
