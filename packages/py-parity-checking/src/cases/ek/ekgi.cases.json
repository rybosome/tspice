  {
    "caseId": "ek-ekgi-audit-vectors-nulls-and-missing",
    "description": "Compare every vector element, true missing elements, NULL with large nonnegative element index, last-row value and a valid fetch after misses. Actual pinned N0067 returns NULL before checking the NULL entry element bound.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-query.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT IV FROM AUDIT_QUERY"
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 1
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 2
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 1,
        "elment": 0
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 1,
        "elment": 9
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 2,
        "elment": 0
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 2,
        "elment": 1
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
