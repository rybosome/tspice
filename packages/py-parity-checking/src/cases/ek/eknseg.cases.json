      },
      {
        "op": "ek.ekopr",
        "handleId": "r",
        "path": {
          "kind": "fixture",
          "rel": "kernels/audit-tables-one.ek"
        }
      },
      {
        "op": "ek.eknseg",
        "handleId": "r"
      },
      {
        "op": "ek.ekcls",
        "handleId": "r"
