      },
      {
        "op": "ek.ekopr",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        }
      },
      {
        "op": "ek.ekrced",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V"
      },
      {
        "op": "ek.ekrced",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V"
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
