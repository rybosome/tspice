[
  {
    "caseId": "ek-ekgd-happy-read-double-results",
    "description": "ekgd reads double-precision query results from a workflow-created table",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": ".py-parity-ek-ekgd-happy.ek",
        "ifname": "ekgd-happy",
        "ncomch": 0,
        "handleId": "H_EKGD"
      },
      {
        "op": "ek.ekifld",
        "handleId": "H_EKGD",
        "tabnam": "EKGD_TABLE",
        "nrows": 2,
        "cnames": ["COST"],
        "decls": ["DATATYPE = DOUBLE PRECISION"],
        "segmentId": "SEG_EKGD"
      },
      {
        "op": "ek.ekacld",
        "segmentId": "SEG_EKGD",
        "column": "COST",
        "dvals": [11.5, 22.75],
        "entszs": [1, 1],
        "nlflgs": [false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "SEG_EKGD"
      },
      {
        "op": "ek.ekcls",
        "handleId": "H_EKGD"
      },
      {
        "op": "kernels.furnsh",
        "file": ".py-parity-ek-ekgd-happy.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT COST FROM EKGD_TABLE ORDER BY COST"
      },
      {
        "op": "ek.ekgd",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgd",
        "selidx": 0,
        "row": 1,
        "elment": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
