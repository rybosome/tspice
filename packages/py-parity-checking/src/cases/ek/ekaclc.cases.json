  {
    "caseId": "ek-ekaclc-audit-fixed-vectors-and-null",
    "description": "Actual complete CHARACTER*(40) column write/finalize/close/reload, with fixed-vectors-and-null; compare all concrete values, SQL NULL and absent elements. The fixed NULL row occupies its full declared backing; variable NULL rows have no logical values.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": "audit-ekaclc-fixed-vectors-and-null.ek",
        "ifname": "AUTHORED_COLUMNS",
        "ncomch": 0,
        "handleId": "w"
      },
      {
        "op": "ek.ekifld",
        "handleId": "w",
        "tabnam": "AUDIT_WRITE",
        "nrows": 3,
        "cnames": ["KEY", "DATA"],
        "decls": [
          "DATATYPE=INTEGER,INDEXED=TRUE",
          "DATATYPE=CHARACTER*(40),SIZE=2,NULLS_OK=TRUE"
        ],
        "segmentId": "s"
      },
      {
        "op": "ek.ekacli",
        "segmentId": "s",
        "column": "KEY",
        "ivals": [1, 2, 3],
        "entszs": [1, 1, 1],
        "nlflgs": [false, false, false]
      },
      {
        "op": "ek.ekaclc",
        "segmentId": "s",
        "column": "DATA",
        "cvals": ["  first", "\u00b5moon", "ignored", "unused", "last", ""],
        "entszs": [2, 2, 2],
        "nlflgs": [false, true, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "s"
      },
      {
        "op": "ek.ekcls",
        "handleId": "w"
      },
      {
        "op": "kernels.furnsh",
        "file": "audit-ekaclc-fixed-vectors-and-null.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT DATA FROM AUDIT_WRITE ORDER BY KEY"
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 0,
        "elment": 1
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 0,
        "elment": 2
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 1,
        "elment": 0
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 1,
        "elment": 1
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 1,
        "elment": 2
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 2,
        "elment": 0
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 2,
        "elment": 1
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 2,
        "elment": 2
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
