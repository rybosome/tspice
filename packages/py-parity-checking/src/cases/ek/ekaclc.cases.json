[
  {
    "caseId": "ek-ekaclc-happy-char-column-visible-via-ekgc",
    "description": "ekaclc-written strings are observable through ekfind and ekgc",
    "workflow": [
      {
        "op": "ek.ekopn",
        "path": ".py-parity-ek-ekaclc-happy.ek",
        "ifname": "ekaclc-happy",
        "ncomch": 0,
        "handleId": "H_ACLC"
      },
      {
        "op": "ek.ekifld",
        "handleId": "H_ACLC",
        "tabnam": "CHAR_TABLE",
        "nrows": 2,
        "cnames": ["NAME"],
        "decls": ["DATATYPE = CHARACTER*(*)"],
        "segmentId": "SEG_ACLC"
      },
      {
        "op": "ek.ekaclc",
        "segmentId": "SEG_ACLC",
        "column": "NAME",
        "cvals": ["Alice", "Bob"],
        "entszs": [1, 1],
        "nlflgs": [false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "SEG_ACLC"
      },
      {
        "op": "ek.ekcls",
        "handleId": "H_ACLC"
      },
      {
        "op": "kernels.furnsh",
        "file": ".py-parity-ek-ekaclc-happy.ek"
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT NAME FROM CHAR_TABLE ORDER BY NAME"
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgc",
        "selidx": 0,
        "row": 1,
        "elment": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "ek-ekaclc-missing-column-error",
