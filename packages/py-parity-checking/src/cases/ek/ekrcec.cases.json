  {
    "caseId": "ek-ekrcec-fast-count-segment",
    "description": "Read both scalar records of a finalized fixed-count segment through its original class-specific reader.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        },
        "ifname": "ENTRY_TEST",
        "ncomch": 0
      },
      {
        "op": "ek.ekifld",
        "handleId": "h",
        "tabnam": "FIXED",
        "nrows": 2,
        "cnames": ["V"],
        "decls": ["DATATYPE=CHARACTER*(9),FIXED_COUNT=TRUE"],
        "segmentId": "fast"
      },
      {
        "op": "ek.ekaclc",
        "segmentId": "fast",
        "column": "V",
        "entszs": [1, 1],
        "nlflgs": [false, false],
        "cvals": ["123456789", " Z"]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "fast"
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      },
      {
        "op": "ek.ekopr",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        }
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
