[
  {
    "caseId": "ek-ekrcec-element-order",
    "description": "Read two variable arrays by physical row in reverse order, then read the first again.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        },
        "ifname": "ENTRY_TEST",
        "ncomch": 0
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "SAMPLES",
        "cnames": ["V"],
        "decls": ["DATATYPE=CHARACTER*(9), SIZE=VARIABLE, NULLS_OK=TRUE"]
      },
      {
        "op": "ek.ekappr",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekappr",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekacec",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V",
        "values": [" alpha", "two", "X\t"],
        "isNull": false
      },
      {
        "op": "ek.ekacec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "values": ["Ω", "z"],
        "isNull": false
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      },
      {
        "op": "ek.ekopr",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        }
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
