  {
    "caseId": "ek-ekdelr-populated-file",
    "description": "Finish an independently populated three-row table, edit it, reopen and query both surviving rows and their double values.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c08.ek"
        },
        "ifname": "ORDERS",
        "ncomch": 0
      },
      {
        "op": "ek.ekifld",
        "handleId": "h",
        "tabnam": "SOURCE",
        "segmentId": "s",
        "nrows": 3,
        "cnames": ["ID", "X"],
        "decls": [
          "DATATYPE=INTEGER,INDEXED=TRUE",
          "DATATYPE=DOUBLE PRECISION,NULLS_OK=TRUE"
        ]
      },
      {
        "op": "ek.ekacli",
        "segmentId": "s",
        "column": "ID",
        "ivals": [53, 17, 89],
        "entszs": [1, 1, 1],
        "nlflgs": [false, false, false]
      },
      {
        "op": "ek.ekacld",
        "segmentId": "s",
        "column": "X",
        "dvals": [13.25, 4.25, 22.25],
        "entszs": [1, 1, 1],
        "nlflgs": [false, false, false]
      },
      {
        "op": "ek.ekffld",
        "segmentId": "s"
      },
      {
        "op": "ek.ekdelr",
        "handleId": "h",
        "segno": 0,
        "recno": 1
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      },
      {
        "op": "kernels.furnsh",
        "file": {
          "kind": "scratch",
          "rel": "c08.ek"
        }
      },
      {
        "op": "ek.ekfind",
        "query": "SELECT ID,X FROM SOURCE"
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgd",
        "selidx": 1,
        "row": 0,
        "elment": 0
      },
      {
        "op": "ek.ekgi",
        "selidx": 0,
        "row": 1,
        "elment": 0
      },
      {
        "op": "ek.ekgd",
        "selidx": 1,
        "row": 1,
        "elment": 0
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
