[
  {
    "caseId": "ek-ekacec-persisted-vector",
    "description": "Fill two variable rows out of order, close and reopen, and compare the independent complete entries, order and null flags.",
    "workflow": [
      {
        "op": "ek.ekopn",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        },
        "ifname": "ENTRY_TEST",
        "ncomch": 0
      },
      {
        "op": "ek.ekbseg",
        "handleId": "h",
        "tabnam": "SAMPLES",
        "cnames": ["V"],
        "decls": ["DATATYPE=CHARACTER*(9), SIZE=VARIABLE, NULLS_OK=TRUE"]
      },
      {
        "op": "ek.ekappr",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekappr",
        "handleId": "h",
        "segno": 0
      },
      {
        "op": "ek.ekacec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "values": [" alpha", "two", "X\t"],
        "isNull": false
      },
      {
        "op": "ek.ekacec",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V",
        "values": ["Ω", "z"],
        "isNull": false
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      },
      {
        "op": "ek.ekopr",
        "handleId": "h",
        "path": {
          "kind": "scratch",
          "rel": "c09.ek"
        }
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 0,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekrcec",
        "handleId": "h",
        "segno": 0,
        "recno": 1,
        "column": "V",
        "lenout": 10
      },
      {
        "op": "ek.ekcls",
        "handleId": "h"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
