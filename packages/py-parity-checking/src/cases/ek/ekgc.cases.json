  {
    "caseId": "ek-ekgc-happy-read-two-rows",
    "description": "ekgc reads string query results from the loaded EK fixture",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/py-parity-minimal.ek"
      },
      {
        "op": "ek.ekfind",
