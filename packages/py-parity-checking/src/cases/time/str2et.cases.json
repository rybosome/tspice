[
  {
    "caseId": "time-str2et-happy-j2000",
    "description": "Parses canonical J2000 TDB literal to ET",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 01 12:00:00 TDB"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-str2et-invalid-time-error",
    "description": "Representative parse failure for invalid time literal",
    "workflow": [
      {
        "op": "time.str2et",
        "time": "NOT_A_VALID_TIME_LITERAL"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["UNPARSEDTIME"]
    }
  },
  {
    "caseId": "time-str2et-audit-utc-leap-boundary-and-formats",
    "description": "str2et: utc leap boundary and formats, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.str2et",
        "time": "2016-12-31T23:59:59"
      },
      {
        "op": "time.str2et",
        "time": "2016-12-31T23:59:60"
      },
      {
        "op": "time.str2et",
        "time": "2017-01-01T00:00:00"
      },
      {
        "op": "time.str2et",
        "time": "2000-002T12:00:01.25"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 1 12:00:01.25 TDB"
      },
      {
        "op": "time.str2et",
        "time": "1999 DEC 31 11:59:59.125 TDB"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-str2et-audit-missing-leap-information",
    "description": "str2et: missing leap information, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "time.str2et",
        "time": "2000-01-02T12:00:00"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["NOLEAPSECONDS"]
    }
  },
  {
    "caseId": "time-str2et-audit-invalid-day",
    "description": "str2et: invalid day, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 35 12:00:00"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["BADTIMESTRING"]
    }
  }
]
