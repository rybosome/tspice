        "op": "time.unitim",
        "epoch": 123.25,
        "insys": "TAI",
        "outsys": "ET"
      },
      {
        "op": "time.unitim",
        "epoch": 1.25,
        "insys": "ET",
        "outsys": "JDTDB"
      },
      {
        "op": "time.unitim",
        "epoch": -5,
        "insys": "TDT",
        "outsys": "JDTDT"
      },
      {
        "op": "time.unitim",
        "epoch": 2451545.0000144676,
        "insys": "JDTDB",
        "outsys": "ET"
      },
      {
        "op": "time.unitim",
        "epoch": 2451545.125,
        "insys": "JED",
