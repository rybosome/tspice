        "sc": -12345,
        "clkstr": ":2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1:"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1:256"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "2:0"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1e2.2"
      }
