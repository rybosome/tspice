[
  {
    "caseId": "time-sctiks-raw-field-separators",
    "description": "All five input separators and mixed whitespace encode the same two raw clock fields.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-two-partition.tsc"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1.2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1:2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1-2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1,2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": " 1  2 "
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "000001.002"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-sctiks-absent-fields-and-carry",
