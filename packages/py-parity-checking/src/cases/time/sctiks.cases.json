  {
    "caseId": "time-sctiks-single-field-clock",
    "description": "The lexical count may use leading zeros and exceed signed32.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-ck-clock.tsc"
      },
      {
        "op": "time.sctiks",
