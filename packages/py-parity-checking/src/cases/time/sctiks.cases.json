  {
    "caseId": "time-sctiks-nonzero-field-offsets",
    "description": "The parser subtracts each field offset and an omitted field contributes zero.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-two-partition.tsc"
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "SCLK01_OFFSETS_12345",
        "values": [1, 5]
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1:5"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "1:7"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "2"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "2:5"
      },
      {
        "op": "time.sctiks",
        "sc": -12345,
        "clkstr": "2:6"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-sctiks-below-field-offset",
    "description": "An explicitly supplied minor field is below its minimum.",
    "workflow": [
      {
        "op": "kernels.furnsh",
