[
  {
    "caseId": "time-etcal-tdb-milliseconds",
    "description": "Compare formal TDB calendar output around midday and both sides of the fractional-second boundary.",
    "workflow": [
      {
        "op": "time.etcal",
        "et": 0
      },
      {
        "op": "time.etcal",
        "et": 0.1234
      },
      {
        "op": "time.etcal",
        "et": 0.9999
      },
      {
        "op": "time.etcal",
        "et": -0.0005
      },
      {
        "op": "time.etcal",
        "et": 59.9999
      },
      {
        "op": "time.etcal",
        "et": 60.0001
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
