      {
        "op": "time.timout",
        "et": 0,
        "picture": ""
      }
    ],
    "expectation": {
      "kind": "error"
    }
  },
  {
    "caseId": "time-timout-audit-signed-epochs-systems-and-precision",
    "description": "timout: signed epochs systems and precision, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.timout",
        "et": 1.25,
        "picture": "YYYY-MON-DD HR:MN:SC.### ::TDB"
      },
      {
        "op": "time.timout",
        "et": -86400.875,
        "picture": "YYYY-DOY HR:MN:SC.###### ::TDB"
      },
      {
        "op": "time.timout",
        "et": 536500868.184,
        "picture": "YYYY-MM-DD HR:MN:SC.### ::UTC"
      },
      {
        "op": "time.timout",
        "et": 123456.125,
        "picture": "YYYY-MON-DD HR:MN:SC.############### ::TDT"
      },
      {
        "op": "time.timout",
        "et": 123456.125,
        "picture": "  YYYY MON DD HR:MN:SC ::TDB"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
