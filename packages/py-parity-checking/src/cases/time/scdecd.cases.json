[
  {
    "caseId": "time-scdecd-happy-with-cook-sclk",
    "description": "Decodes cookbook SCLK ticks to partitioned clock string",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "kernels.furnsh",
