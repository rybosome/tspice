[
  {
    "caseId": "time-timdef-stateful-get-set",
    "description": "Exercises timdef state transitions for SYSTEM and CALENDAR",
    "workflow": [
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "SYSTEM"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "SYSTEM",
        "value": "TDB"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "SYSTEM"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "SYSTEM",
        "value": "UTC"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "SYSTEM"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "CALENDAR"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "CALENDAR",
        "value": "GREGORIAN"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "CALENDAR"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-timdef-invalid-system-value-error",
    "description": "Representative timdef error for unsupported SYSTEM value",
    "workflow": [
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "SYSTEM",
        "value": "NOT_A_TIME_SYSTEM"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["BADDEFAULTVALUE"]
    }
  },
  {
    "caseId": "time-timdef-audit-calendar-zone-system-effects",
    "description": "timdef: calendar zone system effects, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "CALENDAR"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "SYSTEM"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "ZONE"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "CALENDAR",
        "value": "JULIAN"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "CALENDAR"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 1 12:00:00"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "CALENDAR",
        "value": "GREGORIAN"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "SYSTEM",
        "value": "TDB"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 1 12:00:00"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "ZONE",
        "value": "UTC+05:30"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "SYSTEM"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "ZONE"
      },
      {
        "op": "time.str2et",
        "time": "2000 JAN 1 12:00:00"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-timdef-audit-early-error-after-mutation",
    "description": "timdef: early error after mutation, compare complete actual live SpiceyPy outputs/effects",
    "workflow": [
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "CALENDAR",
        "value": "JULIAN"
      },
      {
        "op": "time.timdef",
        "action": "SET",
        "item": "ZONE",
        "value": "UTC+05:30"
      },
      {
        "op": "time.timdef",
        "action": "GET",
        "item": "NOT_AN_ITEM"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["BADTIMEITEM"]
    }
  }
]
