        "lon": 0,
        "type": "PLANETOCENTRIC",
        "timlen": 9,
        "ampmlen": 2
      },
      {
        "op": "time.et2lst",
        "body": 10,
        "et": 0,
        "lon": 0,
        "type": "PLANETOCENTRIC",
        "timlen": 6,
        "ampmlen": 9
      },
      {
        "op": "time.et2lst",
        "body": 10,
        "et": 0,
        "lon": 0,
        "type": "PLANETOCENTRIC",
        "timlen": 13,
        "ampmlen": 13
      },
      {
        "op": "time.et2lst",
        "body": 10,
        "et": 0,
        "lon": 0,
        "type": "PLANETOCENTRIC",
        "timlen": 2147483647,
        "ampmlen": 2147483647
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-et2lst-east-west",
    "description": "Compare all five components at signed east and west longitudes, modulo a full rotation.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.tf"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-geometry.bsp"
      },
      {
        "op": "kernel-pool.pcpool",
        "name": "OBJECT_100101_FRAME",
        "values": ["AUDIT_GEOMETRY_FIXED"]
      },
      {
        "op": "kernel-pool.pdpool",
        "name": "BODY100101_PM",
        "values": [0, 125, 0]
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": 0,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": 0.25,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": -0.25,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": 1.5707963267948966,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": -1.5707963267948966,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 100101,
        "et": 0,
        "lon": 6.533185307179586,
        "type": "PLANETOCENTRIC"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
