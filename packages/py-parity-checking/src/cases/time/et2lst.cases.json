[
  {
    "caseId": "time-et2lst-sun",
    "description": "The Sun has noon solar time for every planetocentric longitude without any supplied kernels.",
    "workflow": [
      {
        "op": "time.et2lst",
        "body": 10,
        "et": 1,
        "lon": 0.3,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 10,
        "et": -99,
        "lon": 17.25,
        "type": "PLANETOCENTRIC"
      },
      {
        "op": "time.et2lst",
        "body": 10,
        "et": 0,
        "lon": -0.7,
        "type": "PLANETOCENTRIC"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
    "caseId": "time-et2lst-time-widths",
