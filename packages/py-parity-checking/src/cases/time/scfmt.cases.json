        "ticks": -0.49
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 0
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 0.49
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 0.5
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 1.5
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 255.49
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 255.5
      },
      {
        "op": "time.scfmt",
        "sc": -12345,
        "ticks": 256
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
