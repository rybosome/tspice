    "caseId": "time-scfmt-fractional-and-half-ticks",
    "description": "Round fractional raw ticks before formatting both fields, including a major-field carry.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-two-partition.tsc"
      },
      {
        "op": "time.scfmt",
