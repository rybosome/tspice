  },
  {
    "caseId": "time-scs2e-audit-non-tdb-clock-requires-conversion-info",
    "description": "Non-TDB clock mapping requires actual LSK conversion information.",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/audit-two-partition.tsc"
      },
      {
        "op": "kernel-pool.pipool",
        "name": "SCLK01_TIME_SYSTEM_12345",
        "values": [2]
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "1/1:64"
      }
    ],
    "expectation": {
      "kind": "error",
      "errorMessageIncludes": ["MISSINGTIMEINFO"]
    }
  },
  {
    "caseId": "time-scs2e-audit-non-tdb-clock-with-conversion-info",
