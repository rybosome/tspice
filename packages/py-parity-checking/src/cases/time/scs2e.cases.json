        "values": [2]
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "1/1:64"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  }
