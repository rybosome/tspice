      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "1/1:64"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "1/3:255"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "2/4:0"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "2/4:1"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "2/15:255"
      },
      {
        "op": "time.scs2e",
        "sc": -12345,
        "sclkch": "0:256"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
  {
