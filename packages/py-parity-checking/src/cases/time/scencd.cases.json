[
  {
    "caseId": "time-scencd-happy-with-cook-sclk",
    "description": "Encodes cookbook SCLK string into ticks",
    "workflow": [
      {
        "op": "kernels.furnsh",
        "file": "kernels/naif0012.tls"
      },
      {
        "op": "kernels.furnsh",
        "file": "kernels/cook_01.tsc"
      },
      {
        "op": "time.scencd",
        "sc": -77,
        "sclkch": "593328:90:5:0"
      }
    ],
    "expectation": {
      "kind": "success"
    }
  },
