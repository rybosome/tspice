{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["TSPICE_CSPICE_DIR", "TSPICE_CSPICE_MANIFEST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-publish/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "outputs": [".cache/typecheck*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["TSPICE_EXPECT_NATIVE"],
      "outputs": []
    }
  },
  "globalDependencies": ["scripts/prepare-package.mjs", "tsconfig.base.json"]
}
