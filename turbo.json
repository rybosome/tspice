{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["TSPICE_CSPICE_DIR", "TSPICE_CSPICE_MANIFEST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "outputs": [".cache/typecheck*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["TSPICE_EXPECT_NATIVE"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/backend-node/native/build/Release/tspice_backend_node.node"
      ]
    }
  },
  "globalDependencies": [
    "scripts/prepare-package.mjs",
    "tsconfig.base.json",
    "scripts/docs-api.mjs"
  ]
}
